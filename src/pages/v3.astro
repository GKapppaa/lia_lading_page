---
// Landing v3 — basada en el mockup de la app (7 pantallas).
// Sistema: Apple como base (tiles a todo el ancho que alternan claro/oscuro, el producto
// al centro con la única sombra del sistema, titulares Inter ajustados, un solo color de
// acción en píldora, presión scale(0.95)). La guía recorre la app dentro de un teléfono
// fijo, como las páginas de producto de Apple. Cierre y pie tomados de la landing v1.
import Phone from "../components/v3/Phone.astro";

const title = "Lía — La comida de tu perro llega antes de que se acabe";
const description =
  "Lía calcula cuándo se acaba el saco de tu perro y tu tienda de barrio lo despacha a tiempo. Sin permanencia, cancela cuando quieras.";

const benefits = [
  {
    icon: "clock",
    title: "Calculamos cuándo se acaba su saco",
    desc: "Con su peso, edad y actividad sabemos cuántos gramos come al día y qué día queda vacío.",
  },
  {
    icon: "truck",
    title: "Tu tienda de barrio lo despacha",
    desc: "El pedido llega desde una tienda cercana, cinco días antes de que se termine.",
  },
  {
    icon: "lock",
    title: "Pago seguro, sin permanencia",
    desc: "Pagas cada saco cuando se despacha. Pausas o cancelas desde la app cuando quieras.",
  },
];

// Guía: cada capítulo enciende su pantalla en el teléfono fijo.
const chapters = [
  {
    screen: "foto" as const,
    kicker: "Paso 1 de 3",
    title: "Sube una foto",
    desc: "Así reconoces a tu perro en la app. Puedes cambiarla cuando quieras.",
  },
  {
    screen: "datos" as const,
    kicker: "Paso 2 de 3",
    title: "Cuéntanos de él",
    desc: "Nombre, fecha de nacimiento, peso, raza y cuánto se mueve. Con eso calculamos cuántos gramos come al día. Toma menos de un minuto.",
  },
  {
    screen: "plan" as const,
    kicker: "Paso 3 de 3",
    title: "Elige su alimento",
    desc: "Te mostramos cuánto le dura cada saco y te recomendamos un plan para su tamaño. Activas la reposición automática y listo.",
  },
  {
    screen: "inicio" as const,
    kicker: "Inicio",
    title: "Días de comida, de un vistazo",
    desc: "El anillo te dice cuántos días le quedan y cuándo llega el próximo saco: siempre cinco días antes de que se acabe, desde tu tienda de barrio.",
  },
  {
    screen: "miperro" as const,
    kicker: "Mi perro",
    title: "Su ficha y su plan, en tus manos",
    desc: "Raza, edad, peso, cumpleaños y el historial de cada entrega. ¿Visitas o viaje? Adelanta o pausa una entrega con un toque.",
  },
  {
    screen: "puntos" as const,
    kicker: "Puntos Lía",
    title: "Cada saco a tiempo suma puntos",
    desc: "Junta puntos con cada reposición y canjéalos por descuentos en tu próximo saco o premios para tu perro.",
    points: [
      ["200 pts", "10% en tu próximo saco"],
      ["300 pts", "Snack dental gratis"],
      ["1.500 pts", "Nivel Patita"],
    ],
  },
];

const plans = [
  { id: "esencial", name: "Esencial", price: 28000, desc: "Alimento completo de marca nacional.", items: ["Saco de 12,5 kg", "Despacho desde tu tienda de barrio", "Aviso antes de cada entrega"] },
  { id: "equilibrado", name: "Equilibrado", price: 40000, desc: "Proteína animal como primer ingrediente.", items: ["Saco de 12,5 kg", "Despacho desde tu tienda de barrio", "Cambio de marca sin costo", "Doble de Puntos Lía"], rec: true },
  { id: "premium", name: "Premium", price: 58000, desc: "Fórmulas sin granos o veterinarias.", items: ["Saco de 12,5 kg", "Despacho prioritario", "Cambio de marca sin costo", "Recordatorios de cuidados"] },
];

const faq = [
  ["¿Cómo sabe Lía cuánto come mi perro?", "Usamos una fórmula veterinaria según su peso, edad y nivel de actividad. Después de las primeras entregas la ajustamos con lo que realmente dura cada saco en tu casa."],
  ["¿Qué tienda me trae el saco?", "Una tienda de mascotas de tu barrio asociada a Lía. La ves en la app antes de activar el plan."],
  ["¿Puedo cambiar de plan o de marca?", "Sí, cuando quieras y sin costo desde Mi perro → Gestionar plan. El cambio aplica desde la próxima entrega."],
  ["¿Hay permanencia?", "No. Pagas cada saco cuando se despacha y puedes pausar o cancelar en cualquier momento."],
  ["¿Cómo funcionan los Puntos Lía?", "Sumas puntos con cada reposición a tiempo y los canjeas por descuentos en tu próximo saco o premios para tu perro."],
  ["¿Sirve si tengo más de un perro?", "Sí. Cada perro tiene su ficha y su ración, y si comparten saco sumamos ambos consumos."],
];

const icons: Record<string, string> = {
  clock: "M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z",
  truck: "M3 6h11v10H3zM14 10h4l3 3v3h-7M7.5 18.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm11 0a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z",
  lock: "M6 11h12v9H6zM8.5 11V8a3.5 3.5 0 0 1 7 0v3",
  check: "M5 12.5l4.5 4.5L19 7.5",
};
const clp = (n: number) => "$" + n.toLocaleString("es-CL");
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&family=Poppins:wght@600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>

    <!-- 1. Navegación -->
    <header class="nav">
      <div class="wrap nav-in">
        <a href="#top" class="brand" aria-label="Lía, inicio">
          <img src="/logo_lia.png" alt="" width="30" height="30" />
          <span>Lía</span>
        </a>
        <nav class="nav-links" aria-label="Principal">
          <a href="#como-funciona">Cómo funciona</a>
          <a href="#calcula">Calcula</a>
          <a href="#planes">Planes</a>
          <a href="#preguntas">Preguntas</a>
        </nav>
        <a href="#empezar" class="btn btn-primary btn-sm">Reservar mi lugar</a>
      </div>
    </header>

    <main id="contenido">
      <!-- 2. Hero -->
      <section class="tile tile-dark hero" id="top">
        <div class="wrap hero-copy">
          <p class="eyebrow" data-rise>Beta privada · Reposición automática</p>
          <h1 class="display" data-rise>La comida de tu perro llega antes de que se acabe</h1>
          <p class="lead" data-rise>
            Lía calcula cuándo se termina su saco y tu tienda de barrio lo
            despacha a tiempo. Tú no tienes que acordarte de nada.
          </p>
          <div class="hero-ctas" data-rise>
            <a href="#empezar" class="btn btn-primary">Comenzar gratis</a>
            <a href="#como-funciona" class="btn btn-ghost">Ver la app por dentro</a>
          </div>
        </div>
        <div class="hero-stage">
          <Phone screen="miperro" class="side" />
          <Phone screen="inicio" class="main" label="Pantalla de inicio de la app de Lía: quedan 9 días de comida y la próxima entrega es el jueves 22 de octubre" />
          <Phone screen="puntos" class="side" />
        </div>
      </section>

      <!-- 3. Beneficios -->
      <section class="tile tile-light" aria-labelledby="ben-h">
        <div class="wrap">
          <h2 id="ben-h" class="h2 center" data-rise>Una preocupación menos</h2>
          <div class="ben-grid">
            {
              benefits.map((b) => (
                <article class="ben" data-rise>
                  <span class="ben-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons[b.icon]} /></svg>
                  </span>
                  <h3 class="h3">{b.title}</h3>
                  <p>{b.desc}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- 4. Guía: la app dentro de un teléfono -->
      <section class="tile tile-parchment" id="como-funciona" aria-labelledby="how-h">
        <div class="wrap">
          <header class="tour-head center">
            <p class="eyebrow" data-rise>Cómo funciona</p>
            <h2 id="how-h" class="h2" data-rise>Recorre la app, pantalla a pantalla</h2>
            <p class="sub" data-rise>Configuras a tu perro una vez. Después, Lía trabaja por ti.</p>
          </header>
          <div class="tour" data-tour>
            <div class="tour-stage">
              <Phone screens={chapters.map((c) => c.screen)} class="tour-phone" />
              <ol class="tour-dots" aria-label="Pantallas de la guía">
                {
                  chapters.map((c, i) => (
                    <li>
                      <button type="button" data-goto={i} aria-label={`Ver ${c.kicker}: ${c.title}`} />
                    </li>
                  ))
                }
              </ol>
            </div>
            <ol class="chapters">
              {
                chapters.map((c, i) => (
                  <li class:list={["chapter", { "is-on": i === 0 }]} data-chapter={i}>
                    <span class="kicker">{c.kicker}</span>
                    <h3 class="h3 h3-lg">{c.title}</h3>
                    <p>{c.desc}</p>
                    {c.points && (
                      <ul class="pts">
                        {c.points.map(([pts, prize]) => (
                          <li>
                            <b>{pts}</b>
                            {prize}
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </section>

      <!-- 5. Calculadora -->
      <section class="tile tile-dark" id="calcula" aria-labelledby="calc-h">
        <div class="wrap calc-in">
          <div class="calc-copy">
            <p class="eyebrow" data-rise>Calcula</p>
            <h2 id="calc-h" class="h2" data-rise>¿Cuánto le dura un saco?</h2>
            <p class="lead" data-rise>
              Prueba el cálculo que hace la app. Cambia los datos y mira el
              resultado al instante.
            </p>
          </div>
          <div class="calc-card" data-rise>
            <form class="calc-form" data-calc>
              <label class="field">
                <span>Nombre</span>
                <input name="name" value="Lía" maxlength="20" autocomplete="off" />
              </label>
              <div class="field">
                <span id="kg-l">Peso</span>
                <div class="stepper" role="group" aria-labelledby="kg-l">
                  <button type="button" data-kg="-1" aria-label="Restar 1 kg">−</button>
                  <output name="kgOut"><b data-kg-val>30</b> kg</output>
                  <button type="button" data-kg="1" aria-label="Sumar 1 kg">+</button>
                </div>
                <input type="hidden" name="kg" value="30" />
              </div>
              <fieldset class="field seg-field">
                <legend>Edad</legend>
                <div class="seg">
                  <label><input type="radio" name="age" value="2" /><span>Cachorro</span></label>
                  <label><input type="radio" name="age" value="1.6" checked /><span>Adulto</span></label>
                  <label><input type="radio" name="age" value="1.4" /><span>Senior</span></label>
                </div>
              </fieldset>
              <fieldset class="field seg-field">
                <legend>Nivel de actividad</legend>
                <div class="seg">
                  <label><input type="radio" name="act" value="0.85" /><span>Tranquilo</span></label>
                  <label><input type="radio" name="act" value="1" checked /><span>Normal</span></label>
                  <label><input type="radio" name="act" value="1.25" /><span>Muy activo</span></label>
                </div>
              </fieldset>
            </form>
            <div class="result" aria-live="polite">
              <div class="result-ring" style="--p: 0.75">
                <b data-out="days">31</b>
                <small>días</small>
              </div>
              <div>
                <p class="result-main">
                  Un saco de 12,5 kg le dura a <span data-out="name">Lía</span>
                  unos <span data-out="days">31</span> días
                </p>
                <p class="result-sub">
                  Come unos <b data-out="grams">400</b> g al día. Si empiezas
                  hoy, el próximo saco llegaría el <b data-out="date">—</b>.
                </p>
              </div>
            </div>
            <a href="#planes" class="btn btn-primary btn-block">Ver planes para <span data-out="name">Lía</span></a>
          </div>
        </div>
      </section>

      <!-- 6. Planes -->
      <section class="tile tile-light" id="planes" aria-labelledby="plans-h">
        <div class="wrap">
          <h2 id="plans-h" class="h2 center" data-rise>Elige su alimento</h2>
          <p class="sub center" data-rise>Precio por saco de 12,5 kg, despacho incluido. Sin permanencia.</p>
          <div class="plans" role="radiogroup" aria-label="Planes">
            {
              plans.map((p) => (
                <label class:list={["plan", { "plan-rec": p.rec }]} data-rise>
                  <input type="radio" name="plan" value={p.id} checked={p.rec} data-price={p.price} data-name={p.name} />
                  {p.rec && <span class="rec">Recomendado</span>}
                  <span class="plan-head">
                    <span class="plan-name">{p.name}</span>
                    <span class="radio" aria-hidden="true" />
                  </span>
                  <span class="plan-desc">{p.desc}</span>
                  <span class="plan-price">
                    {clp(p.price)} <small>por saco</small>
                  </span>
                  <ul class="plan-items">
                    {p.items.map((it) => (
                      <li>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons.check} /></svg>
                        {it}
                      </li>
                    ))}
                  </ul>
                </label>
              ))
            }
          </div>
          <div class="plan-summary" data-rise>
            <p>
              Elegiste <b data-plan-name>Equilibrado</b> ·
              <b data-plan-price>$40.000</b> por saco
            </p>
            <a href="#empezar" class="btn btn-primary">Activar reposición automática</a>
          </div>
          <p class="fine center">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons.lock} /></svg>
            Sin permanencia. Cancela cuando quieras.
          </p>
        </div>
      </section>

      <!-- 7. Preguntas -->
      <section class="tile tile-parchment" id="preguntas" aria-labelledby="faq-h">
        <div class="wrap narrow">
          <h2 id="faq-h" class="h2 center" data-rise>Preguntas frecuentes</h2>
          <div class="faq">
            {
              faq.map(([q, a], i) => (
                <details open={i === 0} data-rise>
                  <summary>{q}</summary>
                  <p>{a}</p>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      <!-- 8. Cierre -->
      <section class="tile tile-light cta" id="empezar" aria-labelledby="cta-h">
        <div class="wrap narrow center">
          <h2 id="cta-h" class="cta-h" data-rise>
            ¿Listo para no preocuparte<br />
            <span>nunca más</span>?
          </h2>
          <p class="cta-sub" data-rise>
            Estamos abriendo la beta privada en pocas ciudades. Déjanos tu correo
            y te avisaremos antes que a nadie.
          </p>
          <form class="join" data-join novalidate data-rise>
            <label class="sr-only" for="join-email">Tu correo electrónico</label>
            <input id="join-email" name="email" type="email" placeholder="tu@correo.com" autocomplete="email" required />
            <button type="submit" class="btn btn-primary">Reservar mi lugar</button>
          </form>
          <p class="join-msg" aria-live="polite"></p>
          <p class="join-note" data-rise>
            Únete a los más de <strong>+500</strong> dueños en lista de espera.
          </p>
        </div>
      </section>
    </main>

    <!-- 9. Pie -->
    <footer class="foot">
      <div class="wrap foot-in">
        <a href="#top" class="foot-brand">
          <img src="/logo_lia.png" alt="Logo de Lía" width="48" height="48" />
          <span>Lía</span>
        </a>
        <span class="badge">Beta privada</span>
        <p class="foot-copy">
          © {year} Lía · Hecho con
          <svg class="heart" viewBox="0 0 24 24" role="img" aria-label="amor"><path d="M12 20.5s-7.5-4.6-7.5-10.3A4.2 4.2 0 0 1 12 7.6a4.2 4.2 0 0 1 7.5 2.6c0 5.7-7.5 10.3-7.5 10.3Z" /></svg>
          para perros y sus humanos.
        </p>
      </div>
      <p class="wrap foot-credit">
        Foto del perro: <a href="https://commons.wikimedia.org/w/index.php?curid=1923059">“American Eskimo Dog portrait above”</a>, SheltieBoy, CC BY 2.0.
      </p>
    </footer>

    <style is:global>
      /* Tokens: Apple como estructura, teal de Lía como único color de acción */
      :root {
        --ink: #10322f;
        --muted: #4a6b67;
        --canvas: #ffffff;
        --parchment: #f3f7f6;
        --hairline: #dbe5e3;
        --tint: #e3f4f1;
        --accent: #0d9488;
        --tile: #0b2926;
        --tile-2: #103430;
        --on-dark: #ffffff;
        --on-dark-muted: #b4ccc9;
        --amber-bg: #fef3c7;
        --amber-ink: #b45309;

        /* Acción sobre superficies claras */
        --btn: #0f766e;
        --btn-press: #115e59;
        --on-btn: #ffffff;
        --link: #0f766e;
        --focus: #0f766e;

        --text: "Inter", system-ui, -apple-system, sans-serif;
        --r-sm: 8px;
        --r-md: 11px;
        --r-lg: 18px;
        --nav-h: 52px;
        --section: clamp(64px, 9vw, 112px);
        --product-shadow: rgba(0, 0, 0, 0.22) 3px 5px 30px 0;
      }
      /* Acción sobre superficies oscuras (como el Sky Blue de Apple) */
      .tile-dark, .nav {
        --btn: #2dd4bf;
        --btn-press: #5eead4;
        --on-btn: #042f2c;
        --link: #5eead4;
        --focus: #5eead4;
      }
      .calc-card {
        --btn: #0f766e;
        --btn-press: #115e59;
        --on-btn: #ffffff;
        --focus: #0f766e;
      }

      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; scroll-padding-top: var(--nav-h); -webkit-font-smoothing: antialiased; }
      body { margin: 0; font-family: var(--text); font-size: 17px; line-height: 1.44; letter-spacing: -0.01em; color: var(--ink); background: var(--canvas); overflow-x: hidden; }
      img { max-width: 100%; display: block; }
      h1, h2, h3, p, ul, ol { margin: 0; padding: 0; }
      ul, ol { list-style: none; }
      a { color: inherit; }
      :focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; border-radius: 4px; }
      ::selection { background: var(--accent); color: #fff; }
      .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
      .skip { position: absolute; left: 16px; top: -60px; background: var(--btn); color: var(--on-btn); padding: 10px 16px; border-radius: var(--r-sm); z-index: 100; font-weight: 600; }
      .skip:focus { top: 12px; }
      svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }

      .wrap { width: min(100% - 32px, 1120px); margin-inline: auto; }
      .narrow { width: min(100% - 32px, 760px); }
      .center { text-align: center; }

      /* Tipografía (Apple: 600 en titulares, tracking negativo, cuerpo 17px) */
      .eyebrow { font-size: 15px; font-weight: 600; letter-spacing: -0.01em; color: var(--link); }
      .display { font-weight: 600; font-size: clamp(2.25rem, 1.3rem + 3.6vw, 4rem); line-height: 1.06; letter-spacing: -0.035em; text-wrap: balance; }
      .h2 { font-weight: 600; font-size: clamp(2rem, 1.4rem + 2.2vw, 3rem); line-height: 1.08; letter-spacing: -0.03em; text-wrap: balance; }
      .h3 { font-weight: 600; font-size: 1.3125rem; line-height: 1.19; letter-spacing: -0.015em; }
      .lead { font-size: clamp(1.1875rem, 1rem + 0.6vw, 1.5rem); line-height: 1.4; letter-spacing: -0.01em; }
      .sub { color: var(--muted); margin-top: 16px; font-size: 1.1875rem; }
      .fine { display: flex; justify-content: center; align-items: center; gap: 6px; margin-top: 16px; font-size: 14px; color: var(--muted); }
      .fine svg { width: 16px; height: 16px; }

      /* Botones (píldora, presión scale 0.95, sin sombras) */
      .btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        min-height: 44px; padding: 11px 22px; border-radius: 999px; border: 0;
        font: 600 17px/1.2 var(--text); letter-spacing: -0.01em; text-decoration: none; cursor: pointer;
        transition: transform 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease, color 0.15s ease;
      }
      .btn:active { transform: scale(0.95); }
      .btn-primary { background: var(--btn); color: var(--on-btn); }
      .btn-primary:hover { background: var(--btn-press); }
      .btn-primary:disabled { opacity: 0.7; cursor: default; transform: none; }
      .btn-ghost { color: var(--link); box-shadow: inset 0 0 0 1px currentColor; }
      .btn-ghost:hover { background: rgb(94 234 212 / 0.08); }
      .btn-sm { min-height: 34px; padding: 7px 16px; font-size: 14px; }
      .btn-block { width: 100%; }

      /* Navegación (barra fina y esmerilada) */
      .nav { position: sticky; top: 0; z-index: 50; background: rgb(11 41 38 / 0.82); backdrop-filter: saturate(180%) blur(20px); -webkit-backdrop-filter: saturate(180%) blur(20px); color: var(--on-dark); }
      .nav-in { display: flex; align-items: center; gap: 24px; height: var(--nav-h); }
      .brand { display: inline-flex; align-items: center; gap: 9px; text-decoration: none; font-weight: 600; font-size: 19px; letter-spacing: -0.02em; }
      .brand img { border-radius: 50%; background: #fff; padding: 2px; }
      .nav-links { display: flex; gap: 28px; margin-left: auto; font-size: 13px; letter-spacing: -0.01em; }
      .nav-links a { text-decoration: none; color: var(--on-dark-muted); padding: 8px 0; transition: color 0.15s; }
      .nav-links a:hover { color: #fff; }

      /* Tiles (Apple: el cambio de color es el divisor) */
      .tile { padding-block: var(--section); }
      .tile-dark { background: var(--tile); color: var(--on-dark); }
      .tile-dark .lead { color: var(--on-dark-muted); }
      .tile-light { background: var(--canvas); }
      .tile-parchment { background: var(--parchment); }

      /* Hero: texto centrado y el producto saliendo del borde inferior */
      .hero { padding-top: clamp(56px, 8vw, 104px); padding-bottom: 0; overflow: hidden; }
      .hero-copy { display: grid; justify-items: center; text-align: center; gap: 20px; }
      .hero-copy .display { max-width: 15ch; }
      .hero-copy .lead { max-width: 38ch; }
      .hero-ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 8px; }
      .hero-stage { display: flex; justify-content: center; align-items: flex-start; gap: clamp(16px, 3vw, 40px); height: clamp(380px, 44vw, 560px); margin-top: clamp(48px, 6vw, 72px); overflow: hidden; padding-inline: 16px; }
      .hero-stage .main { zoom: 1.12; }
      .hero-stage .side { margin-top: 72px; opacity: 0.92; }

      /* Beneficios */
      .ben-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 48px; }
      .ben { background: var(--parchment); border-radius: var(--r-lg); padding: 32px 28px; display: grid; gap: 12px; align-content: start; }
      .ben-icon { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: var(--tint); color: var(--btn); margin-bottom: 8px; }
      .ben-icon svg { width: 22px; height: 22px; }
      .ben p { color: var(--muted); }

      /* Guía: teléfono fijo + capítulos que encienden cada pantalla */
      .tour-head { display: grid; justify-items: center; gap: 12px; }
      .tour-head .sub { margin-top: 0; }
      .tour { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; margin-top: 24px; }
      .tour-stage { order: 2; position: sticky; top: var(--nav-h); height: calc(100dvh - var(--nav-h)); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24px; }
      .tour-phone { zoom: 1.08; }
      .tour-dots { display: flex; gap: 8px; }
      .tour-dots button { display: block; width: 8px; height: 8px; padding: 0; border: 0; border-radius: 99px; background: #b9cbc8; cursor: pointer; transition: width 0.3s ease, background-color 0.3s ease; }
      .tour-dots button[aria-current="step"] { width: 24px; background: var(--btn); }
      .tour-dots li { display: grid; place-items: center; min-width: 8px; height: 24px; }
      .chapters { padding-block: 12dvh; }
      .chapter { min-height: 74dvh; display: flex; flex-direction: column; justify-content: center; gap: 12px; max-width: 30rem; transition: opacity 0.4s ease; }
      [data-tour].is-ready .chapter:not(.is-on) { opacity: 0.28; }
      .kicker { font-size: 15px; font-weight: 600; color: var(--btn); }
      .h3-lg { font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.5rem); line-height: 1.1; letter-spacing: -0.03em; }
      .chapter p { color: var(--muted); font-size: 1.1875rem; line-height: 1.47; }
      .pts { display: grid; gap: 8px; margin-top: 8px; }
      .pts li { display: flex; gap: 14px; align-items: baseline; padding: 12px 16px; border-radius: var(--r-md); background: var(--canvas); box-shadow: inset 0 0 0 1px var(--hairline); color: var(--muted); font-size: 15px; }
      .pts b { color: var(--btn); min-width: 76px; }

      /* Calculadora */
      .calc-in { display: grid; grid-template-columns: 1fr 1.15fr; gap: 56px; align-items: center; }
      .calc-copy { display: grid; gap: 16px; }
      .calc-card { background: var(--canvas); color: var(--ink); border-radius: var(--r-lg); padding: clamp(20px, 3vw, 32px); display: grid; gap: 24px; }
      .calc-form { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
      .field { display: grid; gap: 8px; border: 0; padding: 0; margin: 0; min-width: 0; }
      .field > span, .field legend { font-size: 14px; font-weight: 600; color: var(--muted); padding: 0; }
      .field legend { margin-bottom: 8px; }
      .field input:not([type="radio"]) { font: 400 17px var(--text); color: var(--ink); min-height: 48px; padding: 11px 14px; border-radius: var(--r-md); border: 1px solid var(--hairline); background: #fff; width: 100%; }
      .field input:focus { outline: none; border: 2px solid var(--btn); padding: 10px 13px; }
      .stepper { display: grid; grid-template-columns: 48px 1fr 48px; align-items: center; min-height: 48px; border: 1px solid var(--hairline); border-radius: var(--r-md); }
      .stepper button { height: 46px; border: 0; background: none; font-size: 22px; color: var(--btn); cursor: pointer; border-radius: var(--r-md); transition: background-color 0.15s, transform 0.1s; }
      .stepper button:hover { background: var(--tint); }
      .stepper button:active { transform: scale(0.92); }
      .stepper output { text-align: center; font-size: 17px; }
      .seg-field { grid-column: 1 / -1; }
      .seg { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; padding: 4px; background: var(--parchment); border-radius: 999px; }
      .seg input { position: absolute; opacity: 0; pointer-events: none; }
      .seg span { display: flex; align-items: center; justify-content: center; min-height: 40px; border-radius: 999px; font-size: 15px; font-weight: 600; cursor: pointer; transition: background-color 0.15s, color 0.15s; }
      .seg label:hover span { background: var(--tint); }
      .seg input:checked + span { background: var(--btn); color: #fff; }
      .seg input:focus-visible + span { outline: 2px solid var(--focus); outline-offset: 2px; }
      .result { display: grid; grid-template-columns: auto 1fr; gap: 20px; align-items: center; background: var(--tile); color: #fff; border-radius: var(--r-lg); padding: 20px; }
      .result-ring { --p: 0.75; width: 92px; height: 92px; border-radius: 50%; display: grid; place-content: center; text-align: center; position: relative; background: conic-gradient(#2dd4bf calc(var(--p) * 360deg), #1d4a45 0); transition: --p 0.5s ease; }
      .result-ring::before { content: ""; position: absolute; inset: 8px; border-radius: 50%; background: var(--tile); }
      .result-ring > * { position: relative; }
      .result-ring b { font-weight: 600; font-size: 30px; line-height: 1; letter-spacing: -0.03em; }
      .result-ring small { font-size: 12px; color: var(--on-dark-muted); }
      .result-main { font-weight: 600; font-size: 1.25rem; line-height: 1.3; letter-spacing: -0.02em; }
      .result-sub { margin-top: 6px; color: var(--on-dark-muted); font-size: 15px; }
      .result-sub b { color: #fff; }

      /* Planes (tarjetas utilitarias 18px, selección con borde 2px) */
      .plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 48px; align-items: stretch; }
      .plan { position: relative; display: flex; flex-direction: column; gap: 12px; padding: 28px 24px; border-radius: var(--r-lg); background: #fff; box-shadow: inset 0 0 0 1px var(--hairline); cursor: pointer; transition: box-shadow 0.15s, transform 0.15s; }
      .plan:hover { box-shadow: inset 0 0 0 1px #9fbfba; }
      .plan:active { transform: scale(0.99); }
      .plan input { position: absolute; opacity: 0; pointer-events: none; }
      .plan:has(input:checked) { box-shadow: inset 0 0 0 2px var(--btn); }
      .plan:has(input:focus-visible) { outline: 2px solid var(--focus); outline-offset: 3px; }
      .rec { position: absolute; top: -12px; left: 24px; background: var(--btn); color: var(--on-btn); font-size: 13px; font-weight: 600; padding: 3px 12px; border-radius: 999px; }
      .plan-head { display: flex; justify-content: space-between; align-items: center; }
      .plan-name { font-weight: 600; font-size: 1.3125rem; letter-spacing: -0.02em; }
      .radio { width: 22px; height: 22px; border-radius: 50%; box-shadow: inset 0 0 0 2px #a7bbb8; transition: box-shadow 0.15s; }
      .plan:has(input:checked) .radio { box-shadow: inset 0 0 0 7px var(--btn); }
      .plan-desc { color: var(--muted); font-size: 15px; }
      .plan-price { font-weight: 600; font-size: 2rem; line-height: 1.1; letter-spacing: -0.03em; margin-top: 4px; }
      .plan-price small { font-weight: 400; font-size: 15px; color: var(--muted); letter-spacing: -0.01em; }
      .plan-items { display: grid; gap: 10px; margin-top: 8px; padding-top: 16px; border-top: 1px solid var(--hairline); font-size: 15px; }
      .plan-items li { display: flex; gap: 10px; align-items: flex-start; }
      .plan-items svg { color: var(--btn); width: 18px; height: 18px; margin-top: 2px; }
      .plan-summary { margin: 32px auto 0; max-width: 720px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding: 12px 12px 12px 28px; border-radius: 999px; background: var(--parchment); }

      /* Preguntas */
      .faq { margin-top: 40px; border-top: 1px solid var(--hairline); }
      .faq details { border-bottom: 1px solid var(--hairline); }
      .faq summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 22px 4px; font-weight: 600; font-size: 1.1875rem; letter-spacing: -0.02em; }
      .faq summary::-webkit-details-marker { display: none; }
      .faq summary::after { content: "+"; font: 400 28px/1 var(--text); color: var(--btn); transition: transform 0.2s; }
      .faq details[open] summary::after { transform: rotate(45deg); }
      .faq summary:hover { color: var(--btn); }
      .faq details p { padding: 0 4px 22px; color: var(--muted); max-width: 62ch; }

      /* Cierre (de la landing v1) */
      .cta .narrow { display: grid; justify-items: center; }
      .cta-h { font-weight: 800; font-size: clamp(1.875rem, 1.2rem + 2.6vw, 3rem); line-height: 1.08; letter-spacing: -0.035em; color: #134e4a; }
      .cta-h span { color: var(--accent); }
      .cta-sub { margin-top: 20px; max-width: 36rem; font-size: 1.125rem; line-height: 1.55; color: var(--muted); }
      .join { display: flex; gap: 10px; width: min(100%, 420px); margin-top: 40px; }
      .join input { flex: 1 1 0; min-width: 0; min-height: 44px; padding: 0 18px; border: 1px solid #a8e6dc; border-radius: 999px; background: #fff; font: 400 15px var(--text); color: var(--ink); transition: border-color 0.15s, box-shadow 0.15s; }
      .join input::placeholder { color: #3fa597; }
      .join input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px rgb(153 246 228 / 0.6); }
      .join .btn { font-size: 15px; padding-inline: 20px; }
      .join-msg { min-height: 1.5em; margin-top: 12px; font-size: 15px; font-weight: 600; color: var(--btn); }
      .join-note { font-size: 14px; color: var(--muted); }
      .join-note strong { color: var(--btn); }

      /* Pie (de la landing v1) */
      .foot { border-top: 1px solid var(--hairline); padding: 32px 0 24px; font-size: 14px; color: var(--muted); }
      .foot-in { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
      .foot-brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; font-weight: 600; font-size: 1rem; color: #0f766e; }
      .foot-brand img { width: 48px; height: 48px; object-fit: contain; }
      .badge { padding: 2px 10px; border-radius: 999px; background: var(--amber-bg); color: var(--amber-ink); font-size: 12px; font-weight: 600; }
      .foot-copy { margin-left: auto; display: inline-flex; align-items: center; flex-wrap: wrap; gap: 0 5px; }
      .heart { width: 14px; height: 14px; fill: var(--btn); stroke: none; }
      .foot-credit { margin-top: 16px; font-size: 12px; color: #7f9894; }
      .foot-credit a { color: inherit; }

      /* Responsive */
      @media (max-width: 1000px) {
        .nav-links { display: none; }
        .nav-in { justify-content: space-between; }
        .calc-in { grid-template-columns: 1fr; }
        .ben-grid, .plans { grid-template-columns: 1fr; max-width: 520px; margin-inline: auto; }
        .hero-stage .side { display: none; }
      }
      /* Guía en pantallas angostas: el teléfono queda fijo arriba y el texto pasa por debajo */
      @media (max-width: 899px) {
        .tour { grid-template-columns: 1fr; gap: 0; margin-top: 8px; }
        .tour-stage { order: 0; height: auto; z-index: 2; gap: 10px; padding: 12px 0 28px; margin-inline: -16px; background: linear-gradient(var(--parchment) 82%, rgb(243 247 246 / 0)); }
        .tour-phone { zoom: 0.62; }
        .chapters { padding-block: 0 24dvh; }
        .chapter { min-height: 62dvh; justify-content: flex-start; padding-top: 16px; text-align: center; margin-inline: auto; }
        .pts { text-align: left; }
      }
      @media (max-width: 899px) and (max-height: 700px) {
        .tour-phone { zoom: 0.5; }
      }
      @media (min-width: 900px) and (max-height: 760px) {
        .tour-phone { zoom: 0.92; }
      }
      @media (max-width: 600px) {
        .hero-ctas .btn { flex: 1 1 100%; }
        .hero-stage .main { zoom: 1; }
        .calc-form { grid-template-columns: 1fr; }
        .plan-summary { border-radius: var(--r-lg); padding: 20px; }
        .plan-summary .btn { width: 100%; }
        .result { grid-template-columns: 1fr; justify-items: start; }
        .join { flex-direction: column; }
        .foot-in { flex-direction: column; text-align: center; }
        .foot-copy { margin-left: 0; justify-content: center; }
        .foot-credit { text-align: center; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { transition-duration: 0.01ms !important; }
      }
    </style>

    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // ---------- Guía ----------
      // Cada capítulo que cruza la línea de lectura enciende su pantalla en el teléfono fijo.
      const tour = document.querySelector<HTMLElement>("[data-tour]")!;
      const screens = tour.querySelectorAll<HTMLElement>(".tour-phone .screen");
      const chapters = [...tour.querySelectorAll<HTMLElement>("[data-chapter]")];
      const dots = [...tour.querySelectorAll<HTMLButtonElement>("[data-goto]")];
      const stage = tour.querySelector<HTMLElement>(".tour-stage")!;
      const narrow = window.matchMedia("(max-width: 899px)");
      let current = -1;

      function show(i: number) {
        if (i === current) return;
        current = i;
        screens.forEach((s, k) => s.classList.toggle("on", k === i));
        chapters.forEach((c, k) => c.classList.toggle("is-on", k === i));
        dots.forEach((d, k) => (k === i ? d.setAttribute("aria-current", "step") : d.removeAttribute("aria-current")));
      }
      // En angosto el texto se lee bajo el teléfono, así que la línea baja.
      const line = () => (narrow.matches ? "78%" : "center");
      chapters.forEach((ch, i) =>
        ScrollTrigger.create({
          trigger: ch,
          start: () => `top ${line()}`,
          end: () => `bottom ${line()}`,
          onToggle: (self) => self.isActive && show(i),
        }),
      );
      dots.forEach((d, i) =>
        d.addEventListener("click", () => {
          const ch = chapters[i];
          const top = ch.getBoundingClientRect().top + window.scrollY;
          const y = narrow.matches
            ? top - stage.getBoundingClientRect().bottom + 8
            : top + ch.offsetHeight / 2 - window.innerHeight / 2;
          window.scrollTo({ top: y });
        }),
      );
      tour.classList.add("is-ready");
      show(0);

      // ---------- Calculadora ----------
      // Energía 70·kg^0.75 × edad × actividad; croqueta ~3,6 kcal/g; saco de 12,5 kg.
      const BAG_G = 12500;
      const form = document.querySelector<HTMLFormElement>("[data-calc]")!;
      const kgInput = form.querySelector<HTMLInputElement>('input[name="kg"]')!;
      const kgVal = form.querySelector("[data-kg-val]")!;
      const ring = document.querySelector<HTMLElement>(".result-ring")!;
      const fmtDate = new Intl.DateTimeFormat("es-CL", { weekday: "long", day: "numeric", month: "long" });
      const setOut = (k: string, v: string) =>
        document.querySelectorAll(`[data-out="${k}"]`).forEach((el) => (el.textContent = v));

      function compute() {
        const d = new FormData(form);
        const name = String(d.get("name") || "").trim() || "tu perro";
        const kg = Number(d.get("kg"));
        const kcal = 70 * Math.pow(kg, 0.75) * Number(d.get("age")) * Number(d.get("act"));
        const grams = Math.round(kcal / 3.6 / 10) * 10;
        const days = Math.floor(BAG_G / grams);
        const next = new Date();
        next.setDate(next.getDate() + days - 5);
        setOut("name", name);
        setOut("grams", String(grams));
        setOut("days", String(days));
        setOut("date", fmtDate.format(next));
        ring.style.setProperty("--p", String(Math.min(1, days / 60)));
      }
      form.querySelectorAll<HTMLButtonElement>("[data-kg]").forEach((b) =>
        b.addEventListener("click", () => {
          const kg = Math.min(80, Math.max(2, Number(kgInput.value) + Number(b.dataset.kg)));
          kgInput.value = String(kg);
          kgVal.textContent = String(kg);
          compute();
        }),
      );
      form.addEventListener("input", compute);
      form.addEventListener("submit", (e) => e.preventDefault());
      compute();

      // ---------- Planes ----------
      const planName = document.querySelector("[data-plan-name]")!;
      const planPrice = document.querySelector("[data-plan-price]")!;
      document.querySelectorAll<HTMLInputElement>('input[name="plan"]').forEach((r) =>
        r.addEventListener("change", () => {
          planName.textContent = r.dataset.name!;
          planPrice.textContent = "$" + Number(r.dataset.price).toLocaleString("es-CL");
        }),
      );

      // ---------- Reservar mi lugar ----------
      const join = document.querySelector<HTMLFormElement>("[data-join]")!;
      const msg = document.querySelector(".join-msg")!;
      join.addEventListener("submit", (e) => {
        e.preventDefault();
        const email = join.email.value.trim();
        if (!/^\S+@\S+\.\S+$/.test(email)) {
          msg.textContent = "Revisa tu correo, parece incompleto.";
          gsap.fromTo(join, { x: -8 }, { x: 0, duration: 0.5, ease: "elastic.out(1, 0.4)" });
          join.email.focus();
          return;
        }
        msg.textContent = "¡Listo! Te avisaremos antes que a nadie.";
        join.querySelector("button")!.setAttribute("disabled", "");
        gsap.fromTo(join, { scale: 0.985 }, { scale: 1, duration: 0.5, ease: "elastic.out(1, 0.4)" });
      });

      // ---------- Entradas ----------
      if (!reduced) {
        gsap.from(".hero [data-rise]", { y: 24, autoAlpha: 0, duration: 0.8, stagger: 0.08, ease: "power3.out" });
        gsap.from(".hero-stage .phone", { y: 140, autoAlpha: 0, duration: 1.1, stagger: 0.1, delay: 0.25, ease: "power3.out" });
        // Cada sección anima sus partes al entrar; lo que ya está a la vista no se oculta.
        document.querySelectorAll<HTMLElement>("main > section:not(.hero)").forEach((sec) => {
          const items = sec.querySelectorAll("[data-rise]");
          if (!items.length) return;
          ScrollTrigger.create({
            trigger: sec,
            start: "top 85%",
            once: true,
            onEnter: () =>
              gsap.fromTo(items, { y: 24, opacity: 0 }, { y: 0, opacity: 1, duration: 0.7, stagger: 0.07, ease: "power3.out" }),
          });
        });
      }
      window.addEventListener("load", () => ScrollTrigger.refresh());
    </script>
  </body>
</html>
