      const KCAL_PER_G = 3.6;
      const PLAN_PER_KG: Record<string, number> = { economico: 2900, equilibrado: 4600, premium: 7900 };
      const fmtDate = new Intl.DateTimeFormat("es-CL", { weekday: "long", day: "numeric", month: "long" });
      const fmtShort = new Intl.DateTimeFormat("es-CL", { day: "numeric", month: "long" });
      const fmtCLP = new Intl.NumberFormat("es-CL", { style: "currency", currency: "CLP", maximumFractionDigits: 0 });
      const form = document.querySelector<HTMLFormElement>("[data-calc]")!;
      let plan = "equilibrado";
      let gramsPerDay = 0;

      const setOut = (key: string, value: string) =>
        document.querySelectorAll(`[data-out="${key}"]`).forEach((el) => (el.textContent = value));

      function compute() {
        const data = new FormData(form);
        const name = String(data.get("name") || "").trim() || "tu perro";
        const kg = Math.min(90, Math.max(1, Number(data.get("kg")) || 14));
        const bag = Number(data.get("bag")) || 15;
        const factor = Number(data.get("age")) * Number(data.get("act"));
        const kcal = 70 * Math.pow(kg, 0.75) * factor;
        gramsPerDay = Math.round(kcal / KCAL_PER_G / 5) * 5;
        const days = Math.floor((bag * 1000) / gramsPerDay);
        const end = new Date();
        end.setDate(end.getDate() + days);
        const order = new Date(end);
        order.setDate(order.getDate() - 4);
        setOut("name", name);
        setOut("grams", String(gramsPerDay));
        setOut("days", String(days));
        setOut("date", fmtDate.format(end));
        setOut("order", fmtShort.format(order));
        price();
      }
      function price() {
        const kgMonth = (gramsPerDay * 30) / 1000;
        setOut("kgmonth", kgMonth.toLocaleString("es-CL", { maximumFractionDigits: 1 }));
        setOut("price", fmtCLP.format(Math.round((kgMonth * PLAN_PER_KG[plan]) / 100) * 100));
      }
      form.addEventListener("input", compute);
      form.addEventListener("submit", (e) => e.preventDefault());
      compute();

      // ---------- Pestañas de planes ----------
      document.querySelectorAll<HTMLButtonElement>("[data-plan]").forEach((btn) => {
        btn.addEventListener("click", () => {
          plan = btn.dataset.plan!;
          document.querySelectorAll("[data-plan]").forEach((b) => b.setAttribute("aria-selected", String(b === btn)));
          document.querySelectorAll<HTMLElement>("[data-plan-panel]").forEach((p) => (p.hidden = p.dataset.planPanel !== plan));
          price();
          gsap.fromTo(".ticket-price", { y: 10, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.3, ease: "power2.out" });
        });
      });

      // ---------- La app: índice con vista previa ----------
      const showTabs = document.querySelectorAll<HTMLButtonElement>("[data-show]");
      const pick = (id: string) => {
        showTabs.forEach((b) => b.setAttribute("aria-selected", String(b.dataset.show === id)));
        document.querySelectorAll<HTMLElement>("[data-plate]").forEach((p) => p.toggleAttribute("data-on", p.dataset.plate === id));
        document.querySelectorAll<HTMLElement>("[data-show-panel]").forEach((p) => (p.hidden = p.dataset.showPanel !== id));
      };
      showTabs.forEach((b) => {
        b.addEventListener("click", () => pick(b.dataset.show!));
        b.addEventListener("pointerenter", (e) => { if (e.pointerType === "mouse") pick(b.dataset.show!); });
      });

      // ---------- Cierre: la ficha ----------
      const join = document.querySelector<HTMLFormElement>("[data-join]")!;
      const joinName = join.querySelector("[data-join-name]")!;
      join.dog.addEventListener("input", () => (joinName.textContent = join.dog.value.trim() || "tu perro"));
      join.addEventListener("submit", (e) => {
        e.preventDefault();
        const msg = join.querySelector<HTMLElement>(".dialog-msg")!;
        if (!join.email.value.includes("@")) {
          gsap.fromTo(join, { x: -8 }, { x: 0, duration: 0.5, ease: "elastic.out(1, 0.4)" });
          join.email.focus();
          return;
        }
        msg.hidden = false;
        msg.textContent = `Listo. Te escribimos cuando haya cupo para ${join.dog.value.trim() || "tu perro"}.`;
        join.querySelector("button")!.setAttribute("disabled", "");
      });

      // ---------- Entradas ----------
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!reduce) {
        gsap.registerPlugin(ScrollTrigger);
        gsap.from(".hero [data-rise]", { y: 28, autoAlpha: 0, duration: 0.8, stagger: 0.09, ease: "power3.out" });
        gsap.from(".stack .folder", { y: 40, duration: 0.7, stagger: 0.07, delay: 0.2, ease: "power3.out" });
        gsap.from(".front-sheet", { y: 60, duration: 0.9, delay: 0.35, ease: "power3.out" });
        document.querySelectorAll<HTMLElement>("main > section").forEach((sec) => {
          const items = sec.querySelectorAll("[data-rise]");
          if (!items.length) return;
          gsap.from(items, {
            y: 24, autoAlpha: 0, duration: 0.7, stagger: 0.075, ease: "power3.out",
            scrollTrigger: { trigger: sec, start: "top 78%", once: true },
          });
        });
        gsap.from(".slip-row", {
          x: -12, autoAlpha: 0, duration: 0.45, stagger: 0.06, ease: "power2.out",
          scrollTrigger: { trigger: ".slip", start: "top 75%", once: true },
        });
        gsap.to(".how-fig img", {
          scale: 1.12, ease: "none",
          scrollTrigger: { trigger: ".how", start: "top bottom", end: "bottom top", scrub: true },
        });
        gsap.from(".dialog", {
          y: 48, autoAlpha: 0, duration: 0.8, ease: "power3.out",
          scrollTrigger: { trigger: ".cta", start: "top 70%", once: true },
        });
      }
    </script>
  </body>
</html>
