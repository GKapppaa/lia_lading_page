---
// Landing v2 — dirección "La página es el objeto" (taste-skill, seed 1249064938).
// La idea: la ficha de tu perro. La portada es una pila de carpetas con pestañas;
// la carpeta del frente viene abierta con la calculadora del saco.
const title = "Lía — Sabe qué día se acaba el saco de tu perro";
const description =
  "Lía calcula la ración de tu perro por peso, edad y actividad, predice el día en que se acaba el saco y lo pide a tu tienda de barrio antes de que pase.";

const folders = [
  { href: "#preguntas", label: "Preguntas", bg: "var(--f5)", x: "72%" },
  { href: "#barrio", label: "Barrio", bg: "var(--f4)", x: "8%" },
  { href: "#app", label: "La app", bg: "var(--f3)", x: "54%" },
  { href: "#planes", label: "Planes", bg: "var(--f2)", x: "26%" },
];

const slip = [
  {
    when: "Hoy",
    rows: [
      ["Creas la ficha: raza, peso, edad", "2 min"],
      ["Lía calcula su ración diaria", "al instante"],
      ["Eliges plan y tienda de barrio", "1 min"],
    ],
  },
  {
    when: "Día 26",
    rows: [
      ["Lía ve que quedan cuatro días de saco", "aviso"],
      ["La tienda confirma stock y precio", "en la mañana"],
    ],
  },
  {
    when: "Día 28",
    rows: [
      ["El saco sale de la tienda", "tarde"],
      ["Llega a tu puerta", "antes de la cena"],
    ],
  },
];

const plans = [
  {
    id: "economico",
    name: "Económico",
    perKg: 2900,
    desc: "Lo justo y bien medido: buen alimento a precio de supermercado, sin salir de casa.",
    lines: [
      "Alimento completo de marca nacional",
      "Ración ajustada a su peso",
      "Despacho desde tu tienda de barrio",
      "Aviso cuatro días antes",
    ],
  },
  {
    id: "equilibrado",
    name: "Equilibrado",
    perKg: 4600,
    desc: "El que elige la mayoría de los veterinarios para un perro adulto sano.",
    lines: [
      "Proteína animal como primer ingrediente",
      "Ración por peso, edad y actividad",
      "Despacho desde tu tienda de barrio",
      "Cambio de alimento sin costo",
    ],
  },
  {
    id: "premium",
    name: "Premium",
    perKg: 7900,
    desc: "Para perros con alergias, dietas especiales o dueños que no transan.",
    lines: [
      "Fórmula sin granos o veterinaria",
      "Ración revisada cada mes",
      "Despacho prioritario",
      "Recordatorios de medicación",
    ],
  },
];

const showcase = [
  {
    id: "racion",
    tab: "Ración",
    title: "Su plato, al gramo",
    desc: "Lía convierte peso, edad y actividad en gramos por día, y te dice cuántas tazas son con tu medidor. Si sube de peso, la ración se ajusta sola.",
    kind: "img",
    src: "/v2/pile-of-kibble-dog-food-51049786351.jpg",
    alt: "Un puñado de croquetas redondas sobre fondo blanco",
  },
  {
    id: "medicacion",
    tab: "Medicación",
    title: "Pastillas y vacunas a tiempo",
    desc: "Antiparasitario cada tres meses, vacuna anual, la pastilla de las ocho. Lía avisa el día que toca y guarda lo que ya le diste.",
    kind: "ui",
  },
  {
    id: "perfil",
    tab: "Perfil",
    title: "Toda su ficha en un lugar",
    desc: "Raza, peso, alergias, veterinario y su historial de comida. Lo compartes con quien lo cuida cuando tú no estás.",
    kind: "img",
    src: "/v2/woman-and-dog-portrait.jpg",
    alt: "Una mujer sentada en el suelo acaricia a un chow chow frente a un muro amarillo",
  },
];

const faq = [
  ["¿Cómo sabe Lía cuánto come mi perro?", "Parte de una fórmula veterinaria de energía según peso, edad y actividad, y la corrige con lo que realmente dura cada saco en tu casa."],
  ["¿Y si mi perro come menos de lo calculado?", "Le dices a Lía que sobró y mueve la fecha. Después de dos o tres sacos la predicción usa tu propio ritmo."],
  ["¿Quién me trae el saco?", "Tu tienda de mascotas de barrio. Lía le avisa con días de margen y ella despacha o te lo deja listo para retirar."],
  ["¿Puedo elegir la marca?", "Sí. Los planes son rangos de precio; dentro de cada uno eliges la marca que tu tienda tenga en stock."],
  ["¿Cuánto cuesta la app?", "Durante la beta, nada. Pagas el alimento a precio de tienda, más el despacho si lo pides a domicilio."],
  ["¿Sirve si tengo dos perros?", "Sí. Cada uno tiene su ficha y su ración; si comparten saco, Lía suma ambos consumos."],
  ["¿Puedo pausar un pedido?", "Cuando quieras, desde la ficha. Si te vas de viaje, Lía corre la fecha los días que estés fuera."],
  ["¿Qué pasa con mis datos?", "Son tuyos. La tienda solo ve lo necesario para despachar: dirección, producto y cantidad."],
  ["¿Funciona para gatos?", "Estamos empezando con perros. Los gatos llegan después de la beta."],
];

let credits: { title: string; creator: string; license: string; page: string; media: string }[] = [];
try {
  const fs = await import("node:fs");
  credits = JSON.parse(fs.readFileSync("public/v2/credits.json", "utf8"));
} catch {}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Besley:ital,wght@0,800;1,400&family=Libre+Franklin:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Portada: la pila de carpetas -->
    <header class="hero">
      <nav class="top">
        <a href="#top" class="top-mark" aria-label="Lía, inicio">
          <img src="/logo_lia.png" alt="" width="40" height="40" />
        </a>
        <a href="#unirme" class="top-link">Unirme a la beta</a>
      </nav>
      <div class="hero-copy" id="top">
        <h1 class="hero-title" data-rise>Lía</h1>
        <p class="hero-sub" data-rise>
          Sabe qué día se acaba el saco de tu perro y se lo pide a tu tienda de
          barrio antes de que pase.
        </p>
        <a href="#calc-form" class="btn btn-solid hero-btn">Calcular su saco</a>
      </div>
      <div class="stack" aria-label="Secciones">
        {
          folders.map((f) => (
            <a class="folder" href={f.href} style={`--fold:${f.bg};--tab-x:${f.x}`}>
              <span class="tab">{f.label}</span>
            </a>
          ))
        }
      </div>
    </header>

    <main>
      <!-- Carpeta del frente: la calculadora -->
      <section class="front" id="calcula" aria-labelledby="calc-h">
        <div class="front-sheet">
          <span class="tab tab-front">Su saco</span>
          <a href="#calc-form" class="btn btn-solid front-btn">Calcular su saco</a>
          <div class="calc">
            <div class="calc-intro">
              <h2 id="calc-h" class="h-head" data-rise>¿Cuándo se acaba?</h2>
              <p class="lead" data-rise>
                Ponle sus datos. Lía hace la cuenta que harías tú con una
                pesa, un calendario y mucha paciencia.
              </p>
            </div>
            <form id="calc-form" class="calc-form" data-calc>
              <label class="field">
                <span>Nombre</span>
                <input name="name" value="Tobi" maxlength="20" autocomplete="off" />
              </label>
              <label class="field">
                <span>Peso (kg)</span>
                <input name="kg" type="number" inputmode="decimal" min="1" max="90" step="0.5" value="14" />
              </label>
              <label class="field">
                <span>Saco (kg)</span>
                <select name="bag">
                  <option value="3">3 kg</option>
                  <option value="8">8 kg</option>
                  <option value="15" selected>15 kg</option>
                  <option value="20">20 kg</option>
                </select>
              </label>
              <fieldset class="seg">
                <legend>Edad</legend>
                <label><input type="radio" name="age" value="2" /><span>Cachorro</span></label>
                <label><input type="radio" name="age" value="1.6" checked /><span>Adulto</span></label>
                <label><input type="radio" name="age" value="1.4" /><span>Senior</span></label>
              </fieldset>
              <fieldset class="seg">
                <legend>Actividad</legend>
                <label><input type="radio" name="act" value="0.85" /><span>Tranquilo</span></label>
                <label><input type="radio" name="act" value="1" checked /><span>Normal</span></label>
                <label><input type="radio" name="act" value="1.25" /><span>Inquieto</span></label>
              </fieldset>
            </form>
            <output class="result" for="calc-form" aria-live="polite">
              <p class="result-main">
                El saco de <b data-out="name">Tobi</b> se acaba el
                <span class="result-date" data-out="date">—</span>
              </p>
              <dl class="result-rows">
                <div><dt>Ración diaria</dt><dd><span data-out="grams">—</span> g</dd></div>
                <div><dt>Duración del saco</dt><dd><span data-out="days">—</span> días</dd></div>
                <div><dt>Lía avisa a la tienda</dt><dd data-out="order">—</dd></div>
              </dl>
            </output>
          </div>
        </div>
      </section>

      <!-- Cómo funciona: el itinerario en una boleta -->
      <section class="how" aria-labelledby="how-h">
        <div class="how-text">
          <h2 id="how-h" class="h-head" data-rise>Un saco, un mes</h2>
          <p class="body" data-rise>
            Así se ve un mes con Lía para un perro de 14 kg y un saco de 15
            kg. Tú haces la primera línea; el resto pasa solo.
          </p>
          <figure class="how-fig" data-rise>
            <img
              src="/v2/dog-food-1.jpg"
              width="1920"
              height="1440"
              alt="Un saco de croquetas abierto con un medidor de plástico adentro"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>
        <ol class="slip" data-rise>
          {
            slip.map((g) => (
              <li class="slip-group">
                <h3 class="slip-when">{g.when}</h3>
                {g.rows.map(([what, time]) => (
                  <p class="slip-row">
                    <span>{what}</span>
                    <i aria-hidden="true" />
                    <span>{time}</span>
                  </p>
                ))}
              </li>
            ))
          }
          <li class="slip-total">
            <span>Plato lleno los 30 días</span><span>0 viajes tuyos</span>
          </li>
        </ol>
      </section>

      <!-- Planes: el ticket -->
      <section class="plans" id="planes" aria-labelledby="plans-h">
        <div class="plans-head">
          <h2 id="plans-h" class="h-head" data-rise>Tres planes, su ración</h2>
          <div class="plan-tabs" role="tablist" aria-label="Plan">
            {
              plans.map((p, i) => (
                <button
                  role="tab"
                  class="plan-tab"
                  aria-selected={i === 1 ? "true" : "false"}
                  data-plan={p.id}
                >
                  {p.name}
                </button>
              ))
            }
          </div>
        </div>
        <div class="ticket" data-rise>
          <div class="ticket-main">
            {
              plans.map((p, i) => (
                <div class="ticket-plan" data-plan-panel={p.id} hidden={i !== 1}>
                  <div class="ticket-top"><p class="ticket-title">Plan {p.name}</p><p class="ticket-desc">{p.desc}</p></div>
                  <ul class="ticket-lines">
                    {p.lines.map((l) => <li>{l}</li>)}
                  </ul>
                </div>
              ))
            }
          </div>
          <div class="ticket-stub">
            <p class="ticket-price" data-out="price">—</p>
            <p class="ticket-note">al mes para <span data-out="name">Tobi</span>, <span data-out="kgmonth">—</span> kg de alimento</p>
            <a href="#unirme" class="ticket-btn">Quiero este plan</a>
          </div>
          <span class="notch notch-t" aria-hidden="true"></span>
          <span class="notch notch-b" aria-hidden="true"></span>
        </div>
        <p class="plans-note body">
          Precios de referencia en pesos chilenos según la ración calculada
          arriba. El precio final lo pone tu tienda.
        </p>
      </section>

      <!-- La app: plato cuadrado con pestañas -->
      <section class="show" id="app" aria-labelledby="show-h">
        <div class="show-plate">
          {
            showcase.map((s, i) => (
              <div class="plate" data-plate={s.id} data-on={i === 0 ? "" : undefined}>
                {s.kind === "img" ? (
                  <img src={s.src} alt={s.alt} loading="lazy" decoding="async" />
                ) : (
                  <div class="ui" data-ui>
                    <p class="ui-head">Medicación de Tobi</p>
                    <ul class="ui-list">
                      <li class="ui-row ui-due">
                        <span>Antiparasitario interno</span>
                        <b>Hoy, 20:00</b>
                      </li>
                      <li class="ui-row">
                        <span>Pipeta antipulgas</span>
                        <b>24 nov</b>
                      </li>
                      <li class="ui-row">
                        <span>Vacuna óctuple</span>
                        <b>3 mar 2027</b>
                      </li>
                      <li class="ui-row ui-done">
                        <span>Antiparasitario interno</span>
                        <b>Dado 16 jul</b>
                      </li>
                    </ul>
                    <button class="ui-btn" type="button" tabindex="-1">Marcar como dado</button>
                  </div>
                )}
              </div>
            ))
          }
        </div>
        <div class="show-text">
          <div class="show-tabs" role="tablist" aria-label="Funciones de la app">
            {
              showcase.map((s, i) => (
                <button
                  role="tab"
                  class="show-tab"
                  aria-selected={i === 0 ? "true" : "false"}
                  data-show={s.id}
                >
                  {s.tab}
                </button>
              ))
            }
          </div>
          <div class="show-copy">
            {
              showcase.map((s, i) => (
                <div data-show-panel={s.id} hidden={i !== 0}>
                  <h2 id={i === 0 ? "show-h" : undefined} class="h-sub">{s.title}</h2>
                  <p class="body">{s.desc}</p>
                </div>
              ))
            }
          </div>
          <div class="show-actions">
            <a href="#unirme" class="cell cell-ink">Probar la beta</a>
            <a href="#preguntas" class="cell cell-tone">Leer preguntas</a>
          </div>
        </div>
      </section>

      <!-- Barrio: la carta en una hoja -->
      <section class="barrio" id="barrio" aria-label="Por qué tu tienda de barrio">
        <figure class="plate-tip plate-left" data-rise>
          <video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster="/v2/dog-walking-in-the-mission-in-san-poster.jpg"
            aria-label="Un perro de pelo largo camina con correa por una vereda"
          >
            <source src="/v2/dog-walking-in-the-mission-in-san.webm" type="video/webm" />
          </video>
        </figure>
        <article class="letter" data-rise>
          <img class="letter-mark" src="/logo_lia.png" alt="" width="44" height="44" />
          <p>Hola,</p>
          <p>
            Lía nació de una noche cualquiera: el plato vacío, el perro mirando
            y el supermercado ya cerrado. Lo que sí estaba abierto era la tienda
            de la esquina, la de siempre.
          </p>
          <p>
            Esa tienda conoce a tu perro por su nombre, pero no tiene cómo saber
            cuándo se te acaba el saco. Lía es ese dato. Con él, la tienda pide
            a tiempo, guarda tu marca y te despacha sin que tengas que llamar.
          </p>
          <p>
            <mark>Cada pedido queda en el barrio.</mark> No hay bodega central
            ni intermediario: tu tienda vende, tu tienda despacha.
          </p>
          <p>Si tienes una tienda y quieres sumarte a la beta, escríbenos.</p>
          <p class="letter-sign">El equipo de Lía</p>
          <p class="letter-role">Beta privada, 2026</p>
          <div class="letter-strip">
            <a href="mailto:hola@lia.pet?subject=Quiero%20sumar%20mi%20tienda%20a%20L%C3%ADa">hola@lia.pet</a>
          </div>
        </article>
        <figure class="plate-tip plate-right" data-rise>
          <img
            src="/v2/ramirez-pet-shop.jpg"
            width="1024"
            height="768"
            alt="Fachada de una tienda de mascotas de barrio con un mural de pájaros sobre la puerta"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </section>

      <!-- Preguntas: texto corrido -->
      <section class="faq" id="preguntas" aria-labelledby="faq-h">
        <h2 id="faq-h" class="h-sub" data-rise>Preguntas</h2>
        <div class="faq-cols">
          {
            faq.map(([q, a]) => (
              <p data-rise>
                <b>{q}</b> {a}
              </p>
            ))
          }
        </div>
        <figure class="faq-fig" data-rise>
          <img
            src="/v2/american-eskimo-dog-portrait-above.jpg"
            width="1370"
            height="2048"
            alt="Un perro blanco de pelo largo mira hacia arriba con la boca entreabierta"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </section>

      <!-- Cierre: la ficha ya abierta -->
      <section class="cta" id="unirme" aria-labelledby="cta-h">
        <div class="cta-copy">
          <h2 id="cta-h" class="h-close" data-rise>Abre su ficha</h2>
          <p class="body" data-rise>
            Te avisamos por correo cuando haya cupo en tu comuna. Llegas con la
            ficha de tu perro ya creada.
          </p>
        </div>
        <form class="dialog" data-ui data-join novalidate>
          <p class="dialog-title">Nueva ficha</p>
          <label class="dialog-field">
            <span>Nombre de tu perro</span>
            <input name="dog" value="Tobi" maxlength="20" autocomplete="off" />
          </label>
          <label class="dialog-field">
            <span>Tu correo</span>
            <input name="email" type="email" placeholder="tu@correo.cl" autocomplete="email" required />
          </label>
          <fieldset class="dialog-seg">
            <legend>Entrega</legend>
            <label><input type="radio" name="mode" value="casa" checked /><span>A mi casa</span></label>
            <label><input type="radio" name="mode" value="retiro" /><span>Retiro en tienda</span></label>
          </fieldset>
          <button type="submit" class="dialog-btn">Crear la ficha de <span data-join-name>Tobi</span></button>
          <p class="dialog-msg" aria-live="polite" hidden></p>
        </form>
      </section>
    </main>

    <!-- Reverso: el pie -->
    <footer class="foot">
      <div class="foot-cols">
        <div>
          <p class="foot-first">Lía</p>
          <p>Ración, saco y medicación de tu perro, en una ficha.</p>
        </div>
        <div>
          <p class="foot-first">Secciones</p>
          <p><a href="#calcula">Su saco</a></p>
          <p><a href="#planes">Planes</a></p>
          <p><a href="#app">La app</a></p>
          <p><a href="#barrio">Barrio</a></p>
          <p><a href="#preguntas">Preguntas</a></p>
        </div>
        <div>
          <p class="foot-first">Contacto</p>
          <p><a href="mailto:hola@lia.pet">hola@lia.pet</a></p>
          <p><a href="mailto:hola@lia.pet?subject=Tengo%20una%20tienda">Tengo una tienda</a></p>
        </div>
        <div class="foot-credits">
          <p class="foot-first">Fotografías</p>
          {
            credits.map((c) => (
              <p>
                <a href={c.page}>{c.title}</a>, {c.creator}, {c.license}
              </p>
            ))
          }
        </div>
      </div>
      <svg class="foot-word" viewBox="0 0 243 118" role="img" aria-label="Lía">
        <text x="0" y="104">Lía</text>
      </svg>
      <p class="foot-legal">© 2026 Lía. Beta privada.</p>
    </footer>

    <style is:global>
      :root {
        --ink-ground: #2b2a29;
        --ink: #333231;
        --muted: #5f5b57;
        --paper: #f3f3f1;
        --f1: #eeecea;
        --f2: #e4e1dd;
        --f3: #d9d4ce;
        --f4: #cdc3b6;
        --f5: #b9ae9f;
        --accent: #0a7a7f;
        --accent-ink: #ffffff;

        --display: "Besley", Georgia, serif;
        --text: "Libre Franklin", system-ui, sans-serif;
        --step-small: 0.875rem;
        --step-body: 1.0625rem;
        --step-lead: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
        --step-sub: clamp(1.75rem, 1.4rem + 1.2vw, 2.25rem);
        --step-head: clamp(2.25rem, 1.3rem + 3.6vw, 4.25rem);
        --step-display: clamp(6rem, 10vw, 10rem);

        --m: clamp(16px, 3vw, 40px);
        --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }
      body {
        margin: 0;
        background: var(--ink-ground);
        color: var(--ink);
        font-family: var(--text);
        font-size: var(--step-body);
        line-height: 1.5;
        overflow-x: hidden;
      }
      img, video { display: block; max-width: 100%; }
      h1, h2, h3, p, figure, ol, ul, dl, dd { margin: 0; padding: 0; }
      ul, ol { list-style: none; }
      a { color: inherit; }
      ::selection { background: var(--accent); color: var(--accent-ink); }
      :focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
      main { position: relative; z-index: 2; }

      .h-head, .h-close, .hero-title {
        font-family: var(--display);
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 0.95;
      }
      .h-head { font-size: var(--step-head); }
      .h-sub { font-family: var(--display); font-weight: 800; font-size: var(--step-sub); line-height: 1; letter-spacing: -0.02em; }
      .lead { font-size: var(--step-lead); line-height: 1.4; }
      .body { font-size: var(--step-body); max-width: 34ch; }

      .btn {
        display: inline-flex; align-items: center; justify-content: center;
        min-height: 52px; padding: 0 28px;
