---
// Sección "Cómo funciona": 3 tarjetas animadas con ScrollTrigger y stagger.
const steps = [
  {
    n: "01",
    icon: "profile",
    title: "Crea el perfil de tu perro",
    desc: "Raza, peso, edad y nivel de actividad. Lía aprende de tu perro, no de otros.",
  },
  {
    n: "02",
    icon: "calc",
    title: "Nuestro algoritmo calcula su consumo",
    desc: "Combinamos ritmo de consumo real con tu historial para predecir el día exacto.",
  },
  {
    n: "03",
    icon: "truck",
    title: "Recibe el saco en tu puerta",
    desc: "Coordinamos con la tienda de barrio para que llegue antes de que se acabe.",
  },
];

const iconPaths: Record<string, string> = {
  profile:
    "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z",
  calc: "M9 7h6m-6 4h6m-6 4h4m-7 5h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2z",
  truck:
    "M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0",
};
---

<section id="how" class="relative py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mx-auto max-w-2xl text-center">
      <span
        class="inline-block text-xs font-bold uppercase tracking-[0.18em] text-brand-600"
      >
        Cómo funciona
      </span>
      <h2
        class="mt-3 text-3xl font-extrabold tracking-tight text-brand-900 sm:text-5xl"
      >
        Tres pasos. <span class="text-brand-600">Cero ansiedad.</span>
      </h2>
      <p class="mt-4 text-lg text-brand-800/75">
        Lía se encarga del reabastecimiento para que tú solo disfrutes a tu perro.
      </p>
    </div>

    <div
      data-steps-grid
      class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        steps.map((s) => (
          <article
            data-step-card
            class="group relative overflow-hidden rounded-3xl border border-brand-100 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-xl hover:shadow-brand-600/10"
          >
            <span class="absolute right-6 top-6 text-5xl font-black text-brand-100 group-hover:text-accent-400/40">
              {s.n}
            </span>

            <div class="relative flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-50 text-brand-600 transition group-hover:bg-brand-600 group-hover:text-white">
              <svg
                class="h-7 w-7"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d={iconPaths[s.icon]}
                />
              </svg>
            </div>

            <h3 class="mt-6 text-xl font-bold text-brand-900">{s.title}</h3>
            <p class="mt-2 text-base leading-relaxed text-brand-800/75">
              {s.desc}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Respeta prefers-reduced-motion
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (!reduceMotion) {
    gsap.fromTo(
      "[data-step-card]",
      { autoAlpha: 0, y: 40 },
      {
        autoAlpha: 1,
        y: 0,
        duration: 0.7,
        ease: "power3.out",
        stagger: 0.15,
        scrollTrigger: {
          trigger: "[data-steps-grid]",
          start: "top 80%",
          once: true,
        },
      },
    );
  } else {
    gsap.set("[data-step-card]", { autoAlpha: 1, y: 0 });
  }
</script>