---
// Pantallas de la app de Lía recreadas en HTML a partir del mockup.
// Cada variante es una pantalla real del flujo: foto, datos, plan, inicio, mi perro y puntos.
// Con `screens` el mismo teléfono apila varias pantallas y la clase `on` decide cuál se ve
// (lo usa la guía de la landing para recorrer la app con scroll).
type Screen = "foto" | "datos" | "plan" | "inicio" | "miperro" | "puntos";
interface Props {
  screen?: Screen;
  screens?: Screen[];
  label?: string;
  class?: string;
}
const { screen = "inicio", screens, label, class: cls } = Astro.props;
const list = screens ?? [screen];
const dog = "/v2/american-eskimo-dog-portrait-above.jpg";
const steps = { foto: 1, datos: 2, plan: 3 } as Record<string, number>;
const stepTitle = { foto: "Foto", datos: "Datos", plan: "Plan" } as Record<string, string>;
const tabOf = (s: Screen) => (s === "miperro" ? "perro" : s === "puntos" ? "puntos" : "inicio");
---

<figure class:list={["phone", cls]} aria-label={label} aria-hidden={label ? undefined : "true"}>
  <span class="hw" aria-hidden="true"></span>
  {
    list.map((s, idx) => (
      <div class:list={["screen", { on: idx === 0 }]} data-screen={s}>
        {steps[s] && (
          <div class="stepper">
            <span class="back" aria-hidden="true">‹</span>
            <div class="stepper-info">
              <span class="stepper-text">
                Paso {steps[s]} de 3 · {stepTitle[s]}
              </span>
              <span class="bars">
                {[1, 2, 3].map((n) => (
                  <i class={n <= steps[s] ? "on" : ""} />
                ))}
              </span>
            </div>
          </div>
        )}

        {s === "foto" && (
          <div class="body">
            <p class="s-title">Una foto de tu perro</p>
            <p class="s-sub">Así lo reconoces en la app. Puedes cambiarla después.</p>
            <div class="photo">
              <img src={dog} alt="" loading="lazy" />
              <span class="photo-ok">✓ Foto lista</span>
            </div>
            <div class="s-actions">
              <span class="s-btn">Continuar</span>
              <span class="s-btn s-btn-ghost">Elegir otra foto</span>
            </div>
          </div>
        )}

        {s === "datos" && (
          <div class="body">
            <div class="s-head-row">
              <img class="avatar" src={dog} alt="" loading="lazy" />
              <div>
                <p class="s-title">Cuéntanos de tu perro</p>
                <p class="s-sub">Con esto calculamos cuánto come.</p>
              </div>
            </div>
            <span class="f-label">Nombre</span>
            <span class="f-input">Lía</span>
            <div class="f-row">
              <div>
                <span class="f-label">Nacimiento</span>
                <span class="f-input">02/02/2021</span>
              </div>
              <div>
                <span class="f-label">Peso</span>
                <span class="f-input f-step"><b>−</b>30 kg<b>+</b></span>
              </div>
            </div>
            <span class="f-label">Raza</span>
            <span class="f-input">Quiltro (mestizo) ▾</span>
            <span class="f-label">Nivel de actividad</span>
            <span class="seg">
              <i>Tranquilo</i><i class="on">Normal</i><i>Muy activo</i>
            </span>
            <p class="s-note">Paseos diarios de 30 a 60 minutos.</p>
            <div class="s-actions">
              <span class="s-btn">Continuar</span>
            </div>
          </div>
        )}

        {s === "plan" && (
          <div class="body">
            <p class="s-title">Elige el alimento de Lía</p>
            <div class="dark-card">
              <span class="ring ring-sm" style="--p: 0.7" />
              <div>
                <span class="tiny light">Lía · Quiltro · 30 kg · Normal</span>
                <b>Un saco de 12,5 kg le dura ~31 días</b>
                <span class="tiny light">Estimado: unos 400 g al día</span>
              </div>
            </div>
            <div class="opt">
              <span class="sw sw-1" />
              <span class="opt-name">Esencial<small>12,5 kg</small></span>
              <span class="opt-price">$28.000</span>
              <span class="radio" />
            </div>
            <div class="opt opt-on">
              <span class="rec">Recomendado para Lía</span>
              <span class="sw sw-2" />
              <span class="opt-name">Equilibrado<small>12,5 kg</small></span>
              <span class="opt-price">$40.000</span>
              <span class="radio on" />
            </div>
            <div class="opt">
              <span class="sw sw-3" />
              <span class="opt-name">Premium<small>12,5 kg</small></span>
              <span class="opt-price">$58.000</span>
              <span class="radio" />
            </div>
            <div class="s-actions">
              <span class="s-btn">Activar reposición automática</span>
              <span class="s-note center">Sin permanencia. Cancela cuando quieras.</span>
            </div>
          </div>
        )}

        {s === "inicio" && (
          <div class="body">
            <div class="s-head-row between">
              <div>
                <span class="tiny">Hola, Daniela</span>
                <p class="s-title sm">Lía está cubierta</p>
              </div>
              <img class="avatar sm" src={dog} alt="" loading="lazy" />
            </div>
            <div class="dark-card big">
              <span class="ring" style="--p: 0.3">
                <b>9</b>
                <small>días de comida</small>
              </span>
              <div>
                <span class="tiny light">Próxima entrega</span>
                <b class="lg">Jueves 22 oct</b>
                <span class="tiny light">5 días antes de que se acabe el saco</span>
              </div>
              <span class="dark-foot">
                Equilibrado 12,5 kg desde Mascotas Don Pepe <em>Ver</em>
              </span>
            </div>
            <p class="s-label">¿Qué necesita Lía hoy?</p>
            <div class="tiles">
              <span>Consejos</span>
              <span>Alimentos</span>
              <span>Cuidados</span>
            </div>
            <div class="points-row">
              <b>1.250 puntos</b>
              <span class="tiny">250 para Nivel Patita</span>
              <span class="bar"><i style="width: 83%" /></span>
            </div>
          </div>
        )}

        {s === "miperro" && (
          <div class="body">
            <p class="s-title">Mi perro</p>
            <div class="card">
              <div class="s-head-row">
                <img class="avatar" src={dog} alt="" loading="lazy" />
                <div>
                  <b class="lg">Lía</b>
                  <span class="chips">
                    <i>Quiltro</i>
                    <i>5 años</i>
                    <i>30 kg</i>
                  </span>
                </div>
              </div>
              <span class="bday">Cumple 6 años el 2 de febrero</span>
            </div>
            <div class="dark-card col">
              <span class="tiny light">Su plan · Activo</span>
              <b>Equilibrado · 12,5 kg cada ~31 días</b>
              <b class="lg">$40.000 /mes</b>
              <span class="dark-btns">
                <i>Gestionar plan</i>
                <i>Adelantar entrega</i>
              </span>
            </div>
            <p class="s-label">Entregas</p>
            <div class="card list">
              <span><i class="dot dot-o" />Jueves 22 oct<small>Programada</small></span>
              <span><i class="dot" />Lunes 21 sep<small>Entregada a tiempo</small></span>
            </div>
          </div>
        )}

        {s === "puntos" && (
          <div class="body">
            <p class="s-title">Puntos Lía</p>
            <div class="dark-card col">
              <span class="tiny light">Tus puntos · Nivel Huellita</span>
              <b class="xl">1.250</b>
              <span class="bar light"><i style="width: 83%" /></span>
              <span class="tiny light">Te faltan 250 pts para Nivel Patita</span>
            </div>
            <div class="tiles">
              <span>Canjear</span>
              <span>Historial</span>
              <span>Cómo ganar</span>
            </div>
            <p class="s-label">Premios destacados</p>
            <div class="card prize">
              <span class="pct">10%</span>
              <span>10% dcto. en tu próximo saco<small>200 pts</small></span>
              <em>Canjear</em>
            </div>
            <div class="card prize">
              <span class="pct">Gratis</span>
              <span>Snack dental gratis<small>300 pts</small></span>
              <em>Canjear</em>
            </div>
          </div>
        )}

        {!steps[s] && (
          <nav class="tabbar" aria-hidden="true">
            <span class={tabOf(s) === "inicio" ? "on" : ""}>Inicio</span>
            <span class={tabOf(s) === "perro" ? "on" : ""}>Mi perro</span>
            <span class={tabOf(s) === "puntos" ? "on" : ""}>Puntos</span>
          </nav>
        )}
      </div>
    ))
  }
  <div class="sb" aria-hidden="true">
    <span>9:41</span>
    <span class="sb-icons">
      <i class="sig"><i></i><i></i><i></i><i></i></i>
      <i class="bat"></i>
    </span>
  </div>
</figure>

<style>
  @property --p {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }
  .phone {
    --t9: #0d3b44;
    --t6: #2b7f86;
    --t1: #e6f0f0;
    --or: #f28a3c;
    position: relative;
    width: 272px;
    aspect-ratio: 9 / 19;
    margin: 0;
    border-radius: 44px;
    background: #10181a;
    /* Única sombra del sistema: el producto apoyado sobre la superficie */
    box-shadow:
      inset 0 0 0 1.5px #2c373a,
      inset 0 0 0 4px #10181a,
      inset 0 0 0 5px #1e282b,
      rgba(0, 0, 0, 0.22) 3px 5px 30px 0;
    flex-shrink: 0;
    user-select: none;
  }
  /* Botones laterales */
  .phone::before,
  .hw {
    content: "";
    position: absolute;
    width: 3px;
    border-radius: 2px;
    background: #1b2427;
  }
  .phone::before { left: -2px; top: 100px; height: 22px; box-shadow: 0 38px 0 0 #1b2427, 0 76px 0 0 #1b2427; }
  .hw { right: -2px; top: 150px; height: 64px; }
  /* Isla */
  .phone::after {
    content: "";
    position: absolute;
    top: 19px;
    left: 50%;
    width: 78px;
    height: 22px;
    margin-left: -39px;
    border-radius: 99px;
    background: #050809;
    z-index: 3;
  }
  .sb {
    position: absolute;
    top: 9px;
    left: 9px;
    right: 9px;
    height: 34px;
    padding: 0 24px 0 30px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font: 600 11px "Inter", system-ui, sans-serif;
    color: #14272b;
    z-index: 2;
    pointer-events: none;
  }
  .sb-icons { display: flex; gap: 5px; align-items: center; }
  .sig { display: flex; gap: 1.5px; align-items: flex-end; height: 8px; }
  .sig i { display: block; width: 2.5px; border-radius: 1px; background: currentColor; }
  .sig i:nth-child(1) { height: 3px; } .sig i:nth-child(2) { height: 4.5px; } .sig i:nth-child(3) { height: 6px; } .sig i:nth-child(4) { height: 8px; }
  .bat { display: block; width: 18px; height: 8.5px; border-radius: 2.5px; box-shadow: inset 0 0 0 1px rgb(20 39 43 / 0.45); position: relative; }
  .bat::after { content: ""; position: absolute; inset: 1.5px 4px 1.5px 1.5px; border-radius: 1px; background: currentColor; }

  .screen {
    position: absolute;
    inset: 9px;
    border-radius: 36px;
    overflow: hidden;
    background: #f6f8f8;
    color: #14272b;
    font-family: "Inter", system-ui, sans-serif;
    font-size: 11px;
    line-height: 1.35;
    display: flex;
    flex-direction: column;
    opacity: 0;
    transform: translateY(10px) scale(0.985);
    transition: opacity 0.45s ease, transform 0.55s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .screen.on { opacity: 1; transform: none; }
  /* Al entrar una pantalla, sus anillos y barras se llenan */
  .screen:not(.on) .ring { --p: 0 !important; }
  .screen:not(.on) .bar i { width: 0 !important; }
  .ring { transition: --p 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.2s; }
  .bar i { transition: width 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.2s; }

  .body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 40px 16px 14px;
    min-height: 0;
  }
  .stepper + .body { padding-top: 10px; }
  .stepper { display: flex; gap: 10px; align-items: center; padding: 40px 16px 0; }
  .back { width: 24px; height: 24px; border-radius: 50%; background: #fff; display: grid; place-items: center; font-size: 15px; box-shadow: 0 0 0 1px #e1e7e8; }
  .stepper-info { flex: 1; display: grid; gap: 4px; }
  .stepper-text { font-size: 9px; color: #51656a; }
  .bars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; }
  .bars i { height: 3px; border-radius: 3px; background: #d5dfe0; }
  .bars i.on { background: var(--t9); }

  .s-title { font-family: "Poppins", sans-serif; font-weight: 600; font-size: 17px; line-height: 1.2; margin: 0; letter-spacing: -0.01em; }
  .s-title.sm { font-size: 14px; }
  .s-sub, .s-note { margin: 0; color: #51656a; font-size: 10px; }
  .s-note.center { text-align: center; }
  .s-label { margin: 6px 0 0; font-weight: 600; font-size: 11px; }
  .tiny { display: block; font-size: 9px; color: #51656a; }
  .tiny.light, .light { color: #b9d3d5; }
  b { font-weight: 600; }
  .lg { display: block; font-size: 14px; font-family: "Poppins", sans-serif; }
  .xl { display: block; font-size: 26px; font-family: "Poppins", sans-serif; line-height: 1.1; }
  .s-head-row { display: flex; gap: 10px; align-items: center; }
  .s-head-row.between { justify-content: space-between; }
  .avatar { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; }
  .avatar.sm { width: 30px; height: 30px; }

  .photo { position: relative; margin: 14px auto 0; width: 70%; aspect-ratio: 3 / 4; border-radius: 16px; overflow: hidden; }
  .photo img { width: 100%; height: 100%; object-fit: cover; }
  .photo-ok { position: absolute; left: 8px; bottom: 8px; background: #fff; border-radius: 99px; padding: 3px 8px; font-size: 9px; font-weight: 600; }
  .s-actions { margin-top: auto; display: grid; gap: 6px; }
  .s-btn { display: block; text-align: center; padding: 10px; border-radius: 99px; background: var(--or); color: #0a2f37; font-weight: 600; font-size: 11px; }
  .s-btn-ghost { background: #fff; box-shadow: inset 0 0 0 1px #d5dfe0; }

  .f-label { font-size: 9px; color: #51656a; margin-bottom: -4px; }
  .f-input { display: flex; justify-content: space-between; align-items: center; background: #fff; border-radius: 8px; padding: 7px 9px; box-shadow: inset 0 0 0 1px #dbe3e4; font-size: 10px; }
  .f-step b { font-size: 12px; color: var(--t9); }
  .f-row { display: grid; grid-template-columns: 1.3fr 1fr; gap: 8px; }
  .f-row > div { display: grid; gap: 8px; }
  .seg { display: grid; grid-template-columns: repeat(3, 1fr); background: #e5ecec; border-radius: 8px; padding: 2px; }
  .seg i { font-style: normal; text-align: center; padding: 6px 0; font-size: 9px; border-radius: 6px; }
  .seg i.on { background: var(--t9); color: #fff; font-weight: 600; }

  .dark-card { background: var(--t9); color: #fff; border-radius: 14px; padding: 12px; display: flex; gap: 12px; align-items: center; flex-wrap: nowrap; }
  .dark-card.col { flex-direction: column; align-items: stretch; gap: 6px; }
  .dark-card.big { padding: 14px; flex-wrap: wrap; }
  .dark-card.big > div { flex: 1; min-width: 0; }
  .dark-card b:not(.lg):not(.xl) { display: block; font-size: 11px; }
  .ring {
    --p: 0.5;
    width: 74px; height: 74px; border-radius: 50%; flex-shrink: 0;
    background: conic-gradient(#5fc3c4 calc(var(--p) * 360deg), #1f5560 0);
    display: grid; place-content: center; text-align: center; position: relative;
  }
  .ring::before { content: ""; position: absolute; inset: 7px; border-radius: 50%; background: var(--t9); }
  .ring > * { position: relative; }
  .dark-card .ring b { font-size: 24px; font-family: "Poppins", sans-serif; line-height: 1; }
  .ring small { font-size: 7px; color: #b9d3d5; }
  .ring-sm { width: 34px; height: 34px; }
  .ring-sm::before { inset: 4px; }
  .dark-foot { flex-basis: 100%; display: flex; align-items: center; justify-content: space-between; gap: 8px; background: #164a54; border-radius: 9px; padding: 6px 8px; font-size: 9px; }
  .dark-foot em { font-style: normal; background: var(--or); color: #0a2f37; border-radius: 99px; padding: 3px 9px; font-weight: 600; }
  .dark-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-top: 4px; }
  .dark-btns i { font-style: normal; text-align: center; padding: 7px 0; border-radius: 99px; font-size: 9px; font-weight: 600; background: #fff; color: var(--t9); }
  .dark-btns i + i { background: transparent; color: #fff; box-shadow: inset 0 0 0 1px #4f8189; }

  .opt { position: relative; display: flex; align-items: center; gap: 8px; background: #fff; border-radius: 12px; padding: 10px; box-shadow: inset 0 0 0 1px #dbe3e4; }
  .opt-on { box-shadow: inset 0 0 0 2px var(--t9); margin-top: 6px; }
  .rec { position: absolute; top: -8px; left: 10px; background: var(--or); color: #0a2f37; font-size: 8px; font-weight: 600; padding: 2px 7px; border-radius: 99px; }
  .sw { width: 22px; height: 28px; border-radius: 5px; }
  .sw-1 { background: #c9dfe0; } .sw-2 { background: var(--t6); } .sw-3 { background: var(--t9); }
  .opt-name { flex: 1; font-weight: 600; display: grid; }
  .opt-name small, .card small { font-weight: 400; color: #51656a; font-size: 9px; display: block; }
  .opt-price { font-weight: 600; }
  .radio { width: 13px; height: 13px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px #a9b8bb; }
  .radio.on { box-shadow: inset 0 0 0 4px var(--t9); }

  .tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .tiles span { background: #fff; border-radius: 10px; padding: 18px 0 8px; text-align: center; font-size: 9px; box-shadow: inset 0 0 0 1px #e1e7e8; position: relative; }
  .tiles span::before { content: ""; position: absolute; top: 6px; left: 50%; width: 10px; height: 10px; margin-left: -5px; border-radius: 3px; background: var(--t1); box-shadow: inset 0 0 0 2px var(--t6); }
  .points-row { background: #fff; border-radius: 12px; padding: 9px 10px; box-shadow: inset 0 0 0 1px #e1e7e8; display: grid; grid-template-columns: 1fr auto; gap: 5px; }
  .bar { grid-column: 1 / -1; display: block; height: 4px; border-radius: 4px; background: #e5ecec; overflow: hidden; }
  .bar.light { background: #1f5560; }
  .bar i { display: block; height: 100%; background: var(--or); border-radius: 4px; }

  .card { background: #fff; border-radius: 14px; padding: 10px; box-shadow: inset 0 0 0 1px #e1e7e8; display: grid; gap: 8px; }
  .chips { display: flex; gap: 4px; margin-top: 3px; }
  .chips i { font-style: normal; font-size: 8px; background: var(--t1); padding: 2px 6px; border-radius: 99px; }
  .bday { background: #fdf0e6; border-radius: 8px; padding: 5px 8px; font-size: 9px; }
  .list span { display: grid; grid-template-columns: 12px 1fr; font-weight: 600; }
  .list small { grid-column: 2; }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--t9); margin-top: 4px; }
  .dot-o { background: var(--or); }
  .prize { grid-template-columns: 30px 1fr auto; align-items: center; font-weight: 600; }
  .pct { width: 30px; height: 30px; border-radius: 8px; background: #fdf0e6; display: grid; place-items: center; font-size: 9px; }
  .prize em { font-style: normal; background: var(--t9); color: #fff; border-radius: 99px; padding: 4px 9px; font-size: 9px; }

  .tabbar { display: grid; grid-template-columns: repeat(3, 1fr); background: #fff; padding: 10px 0 18px; box-shadow: 0 -1px 0 #e1e7e8; font-size: 9px; text-align: center; color: #51656a; }
  .tabbar span::before { content: ""; display: block; width: 12px; height: 12px; margin: 0 auto 3px; border-radius: 4px; box-shadow: inset 0 0 0 1.5px currentColor; }
  .tabbar .on { color: var(--t9); font-weight: 600; }
</style>
