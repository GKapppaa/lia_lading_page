---
// Footer minimalista con copy de "beta privada".
const year = new Date().getFullYear();
---

<footer class="border-t border-brand-100 bg-white/60 py-10">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-6 text-sm text-brand-700/80 sm:flex-row"
  >
    <div class="flex items-center gap-3">
      <img
        src="/logo_lia.png"
        alt="Logo de Lía"
        class="h-12 w-12 object-contain"
      />
      <span class="text-base font-bold text-brand-700">Lía</span>
      <span class="rounded-full bg-accent-400/20 px-2.5 py-0.5 text-xs font-semibold text-accent-600">
        Beta privada
      </span>
    </div>
    <p>© {year} Lía · Hecho con ❤️ para perros y sus humanos.</p>
  </div>
</footer>