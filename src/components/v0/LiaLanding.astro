---
const tabs = [
  {
    id: "home",
    label: "Su día, de un vistazo",
    shortLabel: "Inicio",
    icon: "⌂",
    description: "Perfil, rutinas y recordatorios importantes en una sola vista.",
    reason: "Para saber qué necesita tu perro sin buscar en varias partes.",
  },
  {
    id: "shop",
    label: "Alimento a tiempo",
    shortLabel: "Tienda",
    icon: "＋",
    description: "Organiza una suscripción y coordina entregas con una tienda local.",
    reason: "Para anticipar la reposición y reducir las compras de último minuto.",
  },
  {
    id: "health",
    label: "Su salud, siempre a mano",
    shortLabel: "Salud",
    icon: "♡",
    description: "Vacunas, peso y próximas citas reunidos en su ficha digital.",
    reason: "Para tener sus antecedentes accesibles cuando los necesites.",
  },
];

const heroSlides = [
  {
    src: "/v2/woman-and-dog-portrait.jpg",
    kind: "image",
    alt: "Una mujer comparte un momento tranquilo con su perro",
    kicker: "El vínculo de todos los días",
    title: "Que las tareas no te quiten tiempo para quererlo.",
    credit: "Foto: Scarleth Marie · CC BY 2.0",
    creditHref: "https://commons.wikimedia.org/w/index.php?curid=108100191",
  },
  {
    src: "/v2/american-eskimo-dog-portrait-above.jpg",
    kind: "image",
    alt: "Primer plano de un perro blanco",
    kicker: "Cada detalle de su cuidado cuenta",
    title: "Lo importante, más fácil de tener presente.",
    credit: "Foto: SheltieBoy · CC BY 2.0",
    creditHref: "https://commons.wikimedia.org/w/index.php?curid=1923059",
  },
  {
    src: "/v2/dog-walking-in-the-mission-in-san.webm",
    poster: "/v2/dog-walking-in-the-mission-in-san-poster.jpg",
    kind: "video",
    alt: "Un perro pasea por su barrio",
    kicker: "Más vida de barrio",
    title: "El cuidado también ocurre cerca de casa.",
    credit: "Video: Sage Ross · CC BY-SA 3.0",
    creditHref: "https://commons.wikimedia.org/wiki/File:Dog_walking_in_the_Mission_in_San_Francisco.ogv",
  },
];

const pillars = [
  {
    number: "01",
    title: "Comida a tiempo",
    body: "Suscripción y entregas a domicilio coordinadas para anticiparse a la próxima bolsa vacía.",
    icon: "feed",
  },
  {
    number: "02",
    title: "Tu tienda de siempre",
    body: "La entrega se coordina con comercios de mascotas de tu barrio.",
    icon: "delivery",
  },
  {
    number: "03",
    title: "Su salud, a mano",
    body: "Una ficha digital para tener sus cuidados importantes en un lugar.",
    icon: "health",
  },
];
---

<div class="lia-v0">
  <header class="site-header">
    <a class="brand" href="#top" aria-label="Lía, inicio">
      <img src="/logo_lia.png" alt="" width="44" height="44" />
      <span>Lía<span class="brand-period">.</span></span>
    </a>
    <button class="mobile-menu-button" type="button" aria-expanded="false" aria-label="Abrir navegación" aria-controls="main-navigation" data-menu-toggle>
      <span class="menu-line"></span><span class="menu-line"></span>
    </button>
    <nav class="desktop-nav" id="main-navigation" aria-label="Navegación principal" data-menu>
      <a href="#como-funciona">Cómo funciona</a>
      <a href="#beneficios">Todo para su cuidado</a>
      <a href="#app">La app</a>
    </nav>
    <a class="button button-small" href="#lista">Quiero conocer Lía <span aria-hidden="true">↗</span></a>
  </header>

  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow" data-hero-item><span class="eyebrow-dot"></span> Cuidado cotidiano, más simple</p>
        <h1 id="hero-title" data-hero-item>Para que cuidar de él se sienta <em>más fácil.</em></h1>
        <p class="hero-intro">
          Menos pendientes en tu cabeza. <strong>Más tiempo para lo que importa.</strong>
          Lía te ayuda a anticiparte con su comida y a tener su cuidado siempre a mano.
        </p>
        <div class="hero-actions" data-hero-item>
          <a class="button" href="#lista">Conoce Lía <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="#app">Explorar la app <span aria-hidden="true">↓</span></a>
        </div>
        <div class="hero-note" data-hero-item>
          <span class="note-check" aria-hidden="true">✓</span>
          Pensada para tu perro y para la vida real.
        </div>
      </div>

      <div class="hero-visual">
        <figure class="hero-carousel" data-hero-carousel aria-roledescription="carrusel" aria-label="Historias del cuidado cotidiano">
          <div class="photo-card" data-hero-viewport>
            {heroSlides.map((slide, index) => (
              <div
                class:list={["hero-slide", index === 0 && "is-active"]}
                data-hero-slide
                data-credit={slide.credit}
                data-credit-href={slide.creditHref}
                aria-hidden={index === 0 ? "false" : "true"}
                role="group"
                aria-roledescription="diapositiva"
                aria-label={`${index + 1} de ${heroSlides.length}`}
              >
                {slide.kind === "video" ? (
                  <video class="hero-slide-media" muted playsinline preload="none" poster={slide.poster} aria-label={slide.alt} data-hero-video>
                    <source src={slide.src} type="video/webm" />
                  </video>
                ) : (
                  <img
                    class="hero-slide-media"
                    src={slide.src}
                    alt={slide.alt}
                    width={index === 1 ? "1370" : "1920"}
                    height={index === 1 ? "2048" : "1275"}
                    loading={index === 0 ? "eager" : "lazy"}
                    fetchpriority={index === 0 ? "high" : "auto"}
                  />
                )}
                <div class="photo-wash" aria-hidden="true"></div>
                <div class="photo-caption">
                  <span class="caption-kicker">{slide.kicker}</span>
                  <span class="caption-title">{slide.title}</span>
                </div>
              </div>
            ))}
          </div>
          <div class="hero-carousel-controls" aria-label="Controles del carrusel">
            <div class="carousel-dots" role="group" aria-label="Elegir imagen">
              {heroSlides.map((slide, index) => (
                <button
                  type="button"
                  class:list={["carousel-dot", index === 0 && "is-active"]}
                  data-hero-dot={index}
                  aria-label={`Mostrar imagen ${index + 1}: ${slide.kicker}`}
                  aria-current={index === 0 ? "true" : undefined}
                ></button>
              ))}
            </div>
            <div class="carousel-actions">
              <button type="button" class="carousel-control" data-hero-prev aria-label="Imagen anterior">←</button>
              <button type="button" class="carousel-control" data-hero-next aria-label="Imagen siguiente">→</button>
              <button type="button" class="carousel-control carousel-pause" data-hero-pause aria-label="Pausar carrusel"><span data-pause-symbol aria-hidden="true">Ⅱ</span></button>
            </div>
          </div>
          <figcaption class="hero-credit">Crédito de la imagen: <a href={heroSlides[0].creditHref} target="_blank" rel="noreferrer" data-hero-credit>{heroSlides[0].credit}</a></figcaption>
        </figure>
      </div>
    </section>

    <section class="app-experience" id="app" aria-labelledby="app-title">
      <div class="experience-heading">
        <p class="eyebrow">Una app para el día a día</p>
        <h2 id="app-title">Cada cosa importante,<br /><em>en su lugar.</em></h2>
        <p>Explora cómo Lía reúne el cuidado cotidiano de tu perro en una experiencia sencilla.</p>
      </div>

      <div class="experience-layout">
        <div class="feature-menu" role="tablist" aria-label="Funciones de Lía">
          {tabs.map((tab, index) => (
            <button
              id={`feature-tab-${tab.id}`}
              type="button"
              role="tab"
              aria-selected={tab.id === "home" ? "true" : "false"}
              aria-controls={`app-view-${tab.id}`}
              data-app-tab={tab.id}
              class:list={["feature-tab", tab.id === "home" && "is-selected"]}
            >
              <span class="feature-index">0{index + 1}</span>
              <span class="feature-copy">
                <strong>{tab.label}</strong>
                <span>{tab.description}</span>
                <span class="feature-reason"><b>¿Por qué está aquí?</b> {tab.reason}</span>
              </span>
              <span class="feature-arrow" aria-hidden="true">↗</span>
            </button>
          ))}
        </div>

        <div class="phone-stage">
          <div class="phone-wrap" role="region" aria-label="Vista previa interactiva de la aplicación Lía">
            <div class="phone-shell">
              <div class="phone-island" aria-hidden="true"></div>
              <div class="phone-screen">
                <div class="phone-status"><span>9:41</span><span aria-hidden="true">●●●  ▰</span></div>
                <div class="app-heading">
                  <div><span class="app-overline">BUENOS DÍAS</span><h3>Hola, Camila</h3></div>
                  <img class="pet-avatar" src="/v2/american-eskimo-dog-portrait-above.jpg" alt="Perro del perfil de ejemplo" width="1370" height="2048" loading="lazy" />
                </div>
                <span class="demo-tag">MUESTRA · DATOS ILUSTRATIVOS</span>

                <div class="app-views" aria-live="polite">
                  <section class="app-view is-active" id="app-view-home" role="tabpanel" aria-labelledby="feature-tab-home">
                    <p class="screen-label">RESUMEN DE MORA</p>
                    <div class="pet-card">
                      <div class="pet-card-top"><span class="pet-icon" aria-hidden="true">⌂</span><span class="soft-pill">Vista de ejemplo</span></div>
                      <h4>Todo sobre Mora,<br />en un solo lugar.</h4>
                      <p>Perfil, rutina y recordatorios de cuidado.</p>
                      <div class="pet-card-rule"></div>
                      <button class="phone-action" type="button" data-open-tab="health">Ver ficha de Mora <span aria-hidden="true">→</span></button>
                    </div>
                    <button class="reminder-card" type="button" data-open-tab="shop"><span class="reminder-icon" aria-hidden="true">◷</span><span><b>Próximo paso</b><span>Organiza su siguiente entrega.</span></span><span class="record-arrow" aria-hidden="true">→</span></button>
                  </section>

                  <section class="app-view" id="app-view-shop" role="tabpanel" aria-labelledby="feature-tab-shop" hidden>
                    <p class="screen-label">SU COMIDA, SIN OLVIDOS</p>
                    <div class="shop-card"><div class="food-illustration" aria-hidden="true">◌</div><span class="card-overline">SUSCRIPCIÓN DE ALIMENTO</span><h4>Su favorito,<br />a tiempo.</h4><p>Planifica la reposición y coordina la entrega a domicilio con una tienda local.</p><div class="delivery-chip"><span></span> Entrega coordinada</div></div>
                    <button class="phone-action phone-action-filled" type="button" data-open-tab="home">Revisar resumen <span aria-hidden="true">→</span></button>
                  </section>

                  <section class="app-view" id="app-view-health" role="tabpanel" aria-labelledby="feature-tab-health" hidden>
                    <p class="screen-label">FICHA VETERINARIA</p>
                    <div class="health-card"><span class="health-mark">♡</span><span class="card-overline">PERFIL DE MORA</span><h4>Su historia,<br />bien guardada.</h4><p>Un espacio claro para sus datos y cuidados.</p></div>
                    <div class="record-row"><span class="record-icon">＋</span><span><b>Vacunas</b><small>Historial y próximas dosis</small></span><span class="record-arrow">→</span></div>
                    <div class="record-row"><span class="record-icon">⌁</span><span><b>Peso</b><small>Seguimiento desde su perfil</small></span><span class="record-arrow">→</span></div>
                    <div class="record-row"><span class="record-icon">＋</span><span><b>Próximas citas</b><small>Fechas y notas importantes</small></span><span class="record-arrow">→</span></div>
                    <button class="phone-action phone-action-filled" type="button" data-open-tab="shop">Ver plan de alimento <span aria-hidden="true">→</span></button>
                  </section>
                </div>

                <div class="phone-tabs" aria-hidden="true">
                  {tabs.map((tab) => (
                    <span class:list={["phone-tab", tab.id === "home" && "is-selected"]} data-phone-indicator={tab.id}>
                      <span class="tab-icon">{tab.icon}</span>
                      <span>{tab.shortLabel}</span>
                    </span>
                  ))}
                </div>
              </div>
            </div>
            <a class="dog-credit" href="https://commons.wikimedia.org/w/index.php?curid=1923059" target="_blank" rel="noreferrer">Foto del perfil: SheltieBoy · CC BY 2.0</a>
            <div class="phone-shadow" aria-hidden="true"></div>
          </div>
        </div>
      </div>
    </section>

    <section class="pillars-section" id="como-funciona" aria-labelledby="pillars-title">
      <div class="section-heading">
        <p class="eyebrow">Una ayuda que acompaña</p>
        <h2 id="pillars-title">Lo esencial de su cuidado,<br /><em>en buenas manos.</em></h2>
      </div>
      <div class="pillars-grid" id="beneficios">
        {pillars.map((pillar) => (
          <article class="pillar-card" data-reveal>
            <div class="pillar-top"><span class="pillar-icon" aria-hidden="true">
              {pillar.icon === "feed" && <svg viewBox="0 0 24 24" fill="none"><path d="M4 8.5h16l-1.4 10H5.4L4 8.5Z"/><path d="M8 8.5 12 4l4 4.5M9 12h.01M15 12h.01"/></svg>}
              {pillar.icon === "delivery" && <svg viewBox="0 0 24 24" fill="none"><path d="M3 6h11v11H3zM14 10h4l3 3v4h-7z"/><circle cx="7.5" cy="18" r="1.5"/><circle cx="17.5" cy="18" r="1.5"/></svg>}
              {pillar.icon === "health" && <svg viewBox="0 0 24 24" fill="none"><path d="M20.5 8.8c0 5.2-8.5 10-8.5 10s-8.5-4.8-8.5-10a4.3 4.3 0 0 1 8.5-1 4.3 4.3 0 0 1 8.5 1Z"/><path d="M8.5 12h7M12 8.5v7"/></svg>}
            </span><span class="pillar-number">{pillar.number}</span></div>
            <h3>{pillar.title}</h3>
            <p>{pillar.body}</p>
            <span class="pillar-arrow" aria-hidden="true">↗</span>
          </article>
        ))}
      </div>
    </section>

    <section class="closing-card" id="lista" data-reveal>
      <div><p class="eyebrow">Un día a la vez, juntos</p><h2>Más calma para ti.<br /><em>Más cuidado para él.</em></h2><p class="closing-copy">Déjanos tu correo para avisarte cuando la lista de espera esté disponible.</p></div>
      <form class="waitlist-form" data-waitlist-form>
        <label class="sr-only" for="waitlist-email">Tu correo electrónico</label>
        <input id="waitlist-email" name="email" type="email" autocomplete="email" placeholder="tu@correo.com" required />
        <button class="button button-light" type="submit">Quiero saber más <span aria-hidden="true">↗</span></button>
        <p class="form-status" role="status" aria-live="polite" data-form-status>Vista previa: el formulario aún no está conectado a una lista real.</p>
      </form>
      <span class="closing-spark" aria-hidden="true">✳</span>
    </section>
  </main>

  <footer class="site-footer"><a class="brand footer-brand" href="#top"><img src="/logo_lia.png" alt="" width="36" height="36" /><span>Lía<span class="brand-period">.</span></span></a><span>Cuidado cotidiano, hecho con cariño.</span><a href="#top">Volver arriba ↑</a></footer>
</div>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-app-tab]"));
  const views = Array.from(document.querySelectorAll<HTMLElement>(".app-view"));
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function selectTab(tab: HTMLButtonElement) {
    const selectedId = tab.dataset.appTab;
    tabs.forEach((item) => {
      const selected = item === tab;
      item.setAttribute("aria-selected", String(selected));
      item.classList.toggle("is-selected", selected);
      item.tabIndex = selected ? 0 : -1;
    });
    views.forEach((view) => {
      const selected = view.id === `app-view-${selectedId}`;
      view.hidden = !selected;
      view.classList.toggle("is-active", selected);
    });
    document.querySelectorAll<HTMLElement>("[data-phone-indicator]").forEach((indicator) => {
      indicator.classList.toggle("is-selected", indicator.dataset.phoneIndicator === selectedId);
    });
  }

  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => selectTab(tab));
    tab.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
      event.preventDefault();
      const direction = event.key === "ArrowRight" ? 1 : -1;
      const next = tabs[(index + direction + tabs.length) % tabs.length];
      next.focus();
      selectTab(next);
    });
  });

  if (tabs[0]) selectTab(tabs[0]);

  document.querySelectorAll<HTMLButtonElement>("[data-open-tab]").forEach((button) => {
    button.addEventListener("click", () => {
      const target = tabs.find((tab) => tab.dataset.appTab === button.dataset.openTab);
      if (target) selectTab(target);
    });
  });

  const menuToggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");
  const closeMenu = () => {
    menuToggle?.setAttribute("aria-expanded", "false");
    menuToggle?.setAttribute("aria-label", "Abrir navegación");
    menu?.classList.remove("is-open");
  };

  menuToggle?.addEventListener("click", () => {
    const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
    menuToggle.setAttribute("aria-expanded", String(!isOpen));
    menuToggle.setAttribute("aria-label", isOpen ? "Abrir navegación" : "Cerrar navegación");
    menu?.classList.toggle("is-open", !isOpen);
  });
  menu?.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menuToggle?.getAttribute("aria-expanded") === "true") {
      closeMenu();
      menuToggle.focus();
    }
  });

  const waitlistForm = document.querySelector<HTMLFormElement>("[data-waitlist-form]");
  const formStatus = document.querySelector<HTMLElement>("[data-form-status]");
  waitlistForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!waitlistForm.reportValidity()) return;
    if (formStatus) formStatus.textContent = "Gracias. Esta vista previa no guarda ni envía tu correo.";
  });

  const heroCarousel = document.querySelector<HTMLElement>("[data-hero-carousel]");
  const heroSlides = Array.from(document.querySelectorAll<HTMLElement>("[data-hero-slide]"));
  const heroDots = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-hero-dot]"));
  const heroCredit = document.querySelector<HTMLAnchorElement>("[data-hero-credit]");
  const pauseButton = document.querySelector<HTMLButtonElement>("[data-hero-pause]");
  const pauseSymbol = document.querySelector<HTMLElement>("[data-pause-symbol]");
  let activeHeroIndex = 0;
  let cycleTimer: number | undefined;
  let pointerInsideCarousel = false;
  let focusInsideCarousel = false;
  let userPausedCarousel = reduceMotion;

  function stopHeroCycle() {
    if (cycleTimer !== undefined) window.clearInterval(cycleTimer);
    cycleTimer = undefined;
    heroSlides[activeHeroIndex]?.querySelector<HTMLVideoElement>("[data-hero-video]")?.pause();
  }

  function startHeroCycle() {
    stopHeroCycle();
    const activeVideo = heroSlides[activeHeroIndex]?.querySelector<HTMLVideoElement>("[data-hero-video]");
    if (reduceMotion || userPausedCarousel || pointerInsideCarousel || focusInsideCarousel || heroSlides.length < 2) {
      activeVideo?.pause();
      return;
    }
    if (activeVideo?.paused) void activeVideo.play().catch(() => undefined);
    cycleTimer = window.setInterval(() => setActiveHero(activeHeroIndex + 1), 6800);
  }

  function setActiveHero(nextIndex: number) {
    if (!heroSlides.length) return;
    activeHeroIndex = (nextIndex + heroSlides.length) % heroSlides.length;
    heroSlides.forEach((slide, index) => {
      const active = index === activeHeroIndex;
      slide.classList.toggle("is-active", active);
      slide.setAttribute("aria-hidden", String(!active));
      const video = slide.querySelector<HTMLVideoElement>("[data-hero-video]");
      if (video) video.pause();
    });
    heroDots.forEach((dot, index) => {
      const active = index === activeHeroIndex;
      dot.classList.toggle("is-active", active);
      if (active) dot.setAttribute("aria-current", "true");
      else dot.removeAttribute("aria-current");
    });
    const activeSlide = heroSlides[activeHeroIndex];
    if (activeSlide && heroCredit) {
      heroCredit.href = activeSlide.dataset.creditHref ?? "#";
      heroCredit.textContent = activeSlide.dataset.credit ?? "Ver crédito de la imagen";
    }
    startHeroCycle();
  }

  heroDots.forEach((dot) => {
    dot.addEventListener("click", () => {
      setActiveHero(Number(dot.dataset.heroDot));
      startHeroCycle();
    });
  });
  document.querySelector("[data-hero-prev]")?.addEventListener("click", () => {
    setActiveHero(activeHeroIndex - 1);
    startHeroCycle();
  });
  document.querySelector("[data-hero-next]")?.addEventListener("click", () => {
    setActiveHero(activeHeroIndex + 1);
    startHeroCycle();
  });
  pauseButton?.addEventListener("click", () => {
    userPausedCarousel = !userPausedCarousel;
    pauseButton.setAttribute("aria-label", userPausedCarousel ? "Reanudar carrusel" : "Pausar carrusel");
    if (pauseSymbol) pauseSymbol.textContent = userPausedCarousel ? "▶" : "Ⅱ";
    if (userPausedCarousel) stopHeroCycle();
    else startHeroCycle();
  });
  if (reduceMotion && pauseButton) {
    pauseButton.disabled = true;
    pauseButton.setAttribute("aria-label", "Animación automática desactivada por preferencia de movimiento reducido");
    if (pauseSymbol) pauseSymbol.textContent = "▶";
  }
  heroCarousel?.addEventListener("pointerenter", () => {
    pointerInsideCarousel = true;
    stopHeroCycle();
  });
  heroCarousel?.addEventListener("pointerleave", () => {
    pointerInsideCarousel = false;
    startHeroCycle();
  });
  heroCarousel?.addEventListener("focusin", () => {
    focusInsideCarousel = true;
    stopHeroCycle();
  });
  heroCarousel?.addEventListener("focusout", (event) => {
    if (event.relatedTarget instanceof Node && heroCarousel.contains(event.relatedTarget)) return;
    focusInsideCarousel = false;
    startHeroCycle();
  });
  setActiveHero(0);

  // Entradas y revelados progresivos; el contenido permanece visible si se reduce el movimiento.
  gsap.registerPlugin(ScrollTrigger);
  if (!reduceMotion) {
    gsap.from("[data-hero-item], .hero-intro", {
      autoAlpha: 0,
      y: 20,
      duration: 0.7,
      stagger: 0.12,
      ease: "power2.out",
      delay: 0.08,
    });
    gsap.from(".photo-card", { autoAlpha: 0, y: 18, duration: 0.9, delay: 0.15, ease: "power2.out" });
    gsap.from(".phone-wrap", {
      autoAlpha: 0,
      y: 22,
      duration: 0.8,
      ease: "power2.out",
      scrollTrigger: { trigger: ".app-experience", start: "top 80%", once: true },
    });
    gsap.from(".feature-tab", {
      autoAlpha: 0,
      x: -18,
      duration: 0.6,
      stagger: 0.1,
      ease: "power2.out",
      scrollTrigger: { trigger: ".experience-layout", start: "top 82%", once: true },
    });
