---
import Phone from "../v3/Phone.astro";

const steps = [
  {
    screen: "foto" as const,
    number: "01",
    kicker: "Su perfil",
    title: "Primero, una foto.",
    body: "Crea un perfil tan único como tu perro. Empieza con su foto y hazlo reconocible en toda la app.",
    note: "Puedes cambiarla cuando quieras.",
  },
  {
    screen: "datos" as const,
    number: "02",
    kicker: "Sus datos",
    title: "Cuéntanos cómo es.",
    body: "Peso, edad, raza y nivel de actividad nos ayudan a estimar cuánto come y cuánto le dura cada saco.",
    note: "Una configuración simple, una sola vez.",
  },
  {
    screen: "plan" as const,
    number: "03",
    kicker: "Su alimento",
    title: "Elige y olvídate del reloj.",
    body: "Compara alternativas, activa la reposición y deja que Lía coordine la próxima entrega con una tienda cercana.",
    note: "Sin permanencia. Pausa o cancela cuando quieras.",
  },
  {
    screen: "inicio" as const,
    number: "04",
    kicker: "Todo bajo control",
    title: "Siempre un paso adelante.",
    body: "Revisa los días de comida restantes, la próxima entrega y el estado del plan desde una sola pantalla.",
    note: "Menos pendientes. Más tiempo juntos.",
  },
];

const benefits = [
  {
    number: "01",
    title: "Calculamos cuándo se acaba",
    body: "Convertimos los datos de tu perro en una estimación de consumo y una fecha de reposición.",
    icon: "clock",
  },
  {
    number: "02",
    title: "Tu tienda de barrio despacha",
    body: "La compra mantiene su cercanía: el pedido se coordina con una tienda de mascotas local.",
    icon: "truck",
  },
  {
    number: "03",
    title: "Tú conservas el control",
    body: "Consulta el plan, adelanta una entrega o pausa la reposición. Sin letra chica ni permanencia.",
    icon: "check",
  },
];

const iconPaths: Record<string, string> = {
  clock: "M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z",
  truck: "M3 6h11v10H3zM14 10h4l3 3v3h-7M7.5 18.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm11 0a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z",
  check: "m5 12 4 4L19 6",
  arrow: "M5 12h14m-5-5 5 5-5 5",
};
---

<div class="lia-home">
  <a class="skip-link" href="#contenido">Saltar al contenido</a>

  <header class="site-header" data-header>
    <div class="nav-wrap">
      <a class="brand" href="#top" aria-label="Lía, inicio">
        <img src="/logo_lia.png" alt="" width="44" height="44" />
        <span>Lía</span>
      </a>

      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Abrir navegación" data-menu-toggle>
        <span></span><span></span>
      </button>

      <nav class="main-nav" id="main-nav" aria-label="Navegación principal" data-menu>
        <a href="#como-funciona">Cómo funciona</a>
        <a href="#calcula">Calcula su saco</a>
        <a href="#beneficios">Beneficios</a>
        <a href="#nosotros">Quiénes somos</a>
        <a href="/tiendas/">Para tiendas</a>
      </nav>

      <a class="button button-small nav-cta" href="#lista">Quiero conocer Lía <span aria-hidden="true">↗</span></a>
    </div>
  </header>

  <main id="contenido">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="hero-orbit orbit-one" aria-hidden="true"></div>
      <div class="hero-orbit orbit-two" aria-hidden="true"></div>
      <div class="hero-word" aria-hidden="true">LÍA</div>

      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow hero-eyebrow" data-hero-item><span></span>Cuidado que se adelanta</p>
          <h1 id="hero-title" data-hero-item>
            La comida llega <em>antes</em> de que se acabe.
          </h1>
          <p class="hero-intro" data-hero-item>
            Lía calcula cuándo se termina el saco de tu perro y coordina la reposición con tu tienda de barrio. Tú disfrutes la compañía; nosotros, las cuentas.
          </p>
          <div class="hero-actions" data-hero-item>
            <a class="button button-primary" href="#lista">Quiero probar Lía <span aria-hidden="true">↗</span></a>
            <a class="button button-ghost" href="#como-funciona">Ver cómo funciona <span aria-hidden="true">↓</span></a>
          </div>
          <ul class="hero-assurances" data-hero-item aria-label="Condiciones del servicio">
            <li><span aria-hidden="true">✓</span>Sin permanencia</li>
            <li><span aria-hidden="true">✓</span>Desde tu tienda local</li>
            <li><span aria-hidden="true">✓</span>Tú tienes el control</li>
          </ul>
        </div>

        <div class="hero-product" data-hero-product>
          <div class="product-halo" aria-hidden="true"></div>
          <div class="hero-phone">
            <Phone screen="inicio" label="Vista previa ilustrativa de Lía: nueve días de comida restantes y próxima entrega programada" />
          </div>
          <div class="floating-card delivery-card" aria-hidden="true">
            <span class="floating-icon"><svg viewBox="0 0 24 24"><path d={iconPaths.truck} /></svg></span>
            <span><small>Próxima entrega</small><strong>Antes de que se acabe</strong></span>
            <i></i>
          </div>
          <div class="floating-card covered-card" aria-hidden="true">
            <span class="covered-dot"></span>
            <span><strong>Todo bajo control</strong><small>Tu perro está cubierto</small></span>
          </div>
          <p class="demo-caption">Vista previa · Datos ilustrativos</p>
        </div>
      </div>

      <div class="hero-bottom">
        <span>Menos compras de urgencia</span>
        <a href="#historia">Descubre Lía <i aria-hidden="true"></i></a>
      </div>
    </section>


    <section class="story section" id="historia" aria-labelledby="story-title">
      <div class="section-wrap story-grid">
        <div class="story-copy" data-reveal>
          <p class="eyebrow"><span>01</span> El final de las compras de urgencia</p>
          <h2 id="story-title">El saco no avisa.<br /><em>Lía sí.</em></h2>
          <p class="section-intro">No deberías tener que levantar la bolsa para saber si alcanza hasta el fin de semana. Lía convierte los datos cotidianos de tu perro en una reposición oportuna.</p>
          <a class="text-link" href="#calcula">Calcula cuánto dura su saco <span aria-hidden="true">↗</span></a>
        </div>

        <div class="story-visual" data-reveal>
          <figure class="story-photo">
            <img src="/v2/woman-and-dog-portrait.jpg" width="1920" height="1275" alt="Una mujer comparte un momento tranquilo con su perro" loading="lazy" />
          </figure>
          <div class="story-quote">
            <span class="quote-mark" aria-hidden="true">“</span>
            <p>Más tiempo para quererlo.<br />Menos pendientes en tu cabeza.</p>
          </div>
          <p class="photo-credit">Foto: <a href="https://commons.wikimedia.org/w/index.php?curid=108100191" target="_blank" rel="noreferrer">Scarleth Marie · CC BY 2.0</a></p>
        </div>
      </div>
    </section>

    <section class="how section" id="como-funciona" aria-labelledby="how-title">
      <div class="section-wrap">
        <header class="section-heading" data-reveal>
          <p class="eyebrow"><span>02</span> Así de simple</p>
          <h2 id="how-title">Tú lo conoces.<br /><em>Lía aprende de él.</em></h2>
          <p>Configura su perfil una vez. Después, la próxima entrega deja de ser otro pendiente.</p>
        </header>

        <div class="how-layout" data-tour>
          <div class="tour-stage">
            <div class="tour-phone">
              <Phone screens={steps.map((step) => step.screen)} label="Recorrido ilustrativo por el perfil y el plan de alimento en la app de Lía" />
            </div>
            <div class="tour-pagination" aria-label="Elegir paso">
              {steps.map((step, index) => (
                <button type="button" data-goto={index} aria-label={`Ver paso ${index + 1}: ${step.title}`} aria-current={index === 0 ? "step" : undefined}><span></span>{step.number}</button>
              ))}
            </div>
          </div>

          <ol class="chapters">
            {steps.map((step, index) => (
              <li class:list={["chapter", { "is-active": index === 0 }]} data-chapter={index}>
                <span class="chapter-number">{step.number}</span>
                <p class="chapter-kicker">{step.kicker}</p>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
                <span class="chapter-note"><i aria-hidden="true"></i>{step.note}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="calculator section" id="calcula" aria-labelledby="calculator-title">
      <div class="calc-orbit" aria-hidden="true"></div>
      <div class="section-wrap calc-grid">
        <div class="calc-copy" data-reveal>
          <p class="eyebrow eyebrow-light"><span>03</span> Una cuenta menos</p>
          <h2 id="calculator-title">¿Cuánto le dura<br /><em>un saco?</em></h2>
          <p>Prueba una estimación orientativa con los datos de tu perro. Ajusta su peso y actividad para ver el resultado al instante.</p>
          <p class="calc-disclaimer">Esta demostración usa una fórmula general y no reemplaza la indicación de un veterinario.</p>
        </div>

        <div class="calc-panel" data-reveal>
          <form class="calc-form" data-calc>
            <label class="field field-name">
              <span>Nombre de tu perro</span>
              <input name="dogName" value="Lía" maxlength="20" autocomplete="off" />
            </label>

            <div class="field">
              <span id="weight-label">Peso</span>
              <div class="weight-stepper" role="group" aria-labelledby="weight-label">
                <button type="button" data-weight="-1" aria-label="Restar un kilogramo">−</button>
                <output><strong data-weight-value>30</strong><small>kg</small></output>
                <button type="button" data-weight="1" aria-label="Sumar un kilogramo">+</button>
              </div>
              <input type="hidden" name="weight" value="30" />
            </div>

            <fieldset class="field activity-field">
              <legend>Nivel de actividad</legend>
              <div class="segment-control">
                <label><input type="radio" name="activity" value="0.85" /><span>Tranquilo</span></label>
                <label><input type="radio" name="activity" value="1" checked /><span>Normal</span></label>
                <label><input type="radio" name="activity" value="1.25" /><span>Muy activo</span></label>
              </div>
            </fieldset>
          </form>

          <div class="calc-result" aria-live="polite">
            <div class="result-ring" data-result-ring style="--progress: 0.52">
              <span><strong data-result="days">31</strong><small>días aprox.</small></span>
            </div>
            <div class="result-copy">
              <p>Un saco de 12,5 kg le duraría a <strong data-result="name">Lía</strong></p>
              <span>Estimado: <b data-result="grams">400</b> g al día</span>
            </div>
          </div>
          <a class="button button-primary button-full" href="#lista">Quiero una reposición a tiempo <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="benefits section" id="beneficios" aria-labelledby="benefits-title">
      <div class="section-wrap">
        <header class="benefits-heading" data-reveal>
          <p class="eyebrow"><span>04</span> La tranquilidad se ve así</p>
          <h2 id="benefits-title">Todo lo que necesita.<br /><em>Nada que recordar.</em></h2>
        </header>

        <div class="benefit-grid">
          {benefits.map((benefit) => (
            <article class="benefit-card" data-reveal>
              <div class="benefit-top">
                <span class="benefit-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={iconPaths[benefit.icon]} /></svg></span>
                <span class="benefit-number">{benefit.number}</span>
              </div>
              <h3>{benefit.title}</h3>
              <p>{benefit.body}</p>
              <span class="benefit-line" aria-hidden="true"></span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="neighborhood" aria-labelledby="neighborhood-title">
      <div class="neighborhood-photo" data-reveal>
        <img src="/v2/ramirez-pet-shop.jpg" width="1024" height="768" alt="Fachada de una tienda de mascotas de barrio" loading="lazy" />
        <p>Foto: <a href="https://www.flickr.com/photos/90809455@N00/5165136800" target="_blank" rel="noreferrer">lavocado@sbcglobal.net · CC BY 2.0</a></p>
      </div>
      <div class="neighborhood-copy" data-reveal>
        <p class="eyebrow eyebrow-light"><span>05</span> Cerca de casa</p>
        <h2 id="neighborhood-title">Tecnología con<br /><em>acento de barrio.</em></h2>
        <p>Lía no viene a reemplazar a quien ya conoce a tu perro. Ayuda a que tu tienda local pueda anticiparse, preparar el pedido y despacharlo a tiempo.</p>
        <a class="text-link text-link-light" href="/tiendas/">Conoce Lía para tiendas <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="about section" id="nosotros" aria-labelledby="about-title">
      <div class="section-wrap about-grid">
        <div class="about-heading" data-reveal>
          <p class="eyebrow">Quiénes somos</p>
          <h2 id="about-title">Cuidar a tu mascota<br />debería ser <em>más simple.</em></h2>
        </div>
        <div class="about-copy" data-reveal>
          <p>Somos una empresa que busca agilizar y facilitar la compra del alimento de tu mascota, con entregas programadas en el día y la hora que elijas.</p>
          <p>Creamos un plan personalizado a partir de los datos que ingresas. Además, la sección <strong>Ficha Vet</strong> reunirá su historial veterinario y, en el futuro, se asociará con veterinarias para facilitar el acceso y la actualización de esa información.</p>
          <div class="about-values" aria-label="Nuestros pilares">
            <span>Compra programada</span>
            <span>Plan personalizado</span>
            <span>Historial veterinario</span>
          </div>
        </div>
      </div>
    </section>

    <section class="closing section" id="lista" aria-labelledby="closing-title">
      <div class="closing-orbit" aria-hidden="true"></div>
      <div class="closing-inner" data-reveal>
        <p class="eyebrow"><span>Un plato lleno, siempre</span></p>
        <h2 id="closing-title">Que lo único pendiente<br />sea <em>salir a pasear.</em></h2>
        <p>Déjanos tu correo para conocer las novedades de Lía y la apertura de la lista de espera.</p>
        <form class="waitlist-form" data-waitlist-form>
          <label class="sr-only" for="waitlist-email">Tu correo electrónico</label>
          <input id="waitlist-email" name="email" type="email" autocomplete="email" placeholder="tu@correo.com" required />
          <button class="button button-primary" type="submit">Quiero saber más <span aria-hidden="true">↗</span></button>
        </form>
        <p class="form-status" role="status" aria-live="polite" data-form-status>Demostración: este formulario todavía no guarda ni envía datos.</p>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-top">
      <a class="brand" href="#top" aria-label="Lía, volver al inicio">
        <img src="/logo_lia.png" alt="" width="52" height="52" />
        <span>Lía</span>
      </a>
      <p>La comida de tu perro llega<br />antes de que se acabe.</p>
      <a class="footer-up" href="#top">Volver arriba <span aria-hidden="true">↑</span></a>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} Lía</span>
      <span>Cuidado cotidiano, más simple.</span>
      <span>Foto de la app: <a href="https://commons.wikimedia.org/w/index.php?curid=1923059" target="_blank" rel="noreferrer">SheltieBoy · CC BY 2.0</a></span>
    </div>
  </footer>
</div>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const menuButton = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");
  const closeMenu = () => {
    menuButton?.setAttribute("aria-expanded", "false");
    menuButton?.setAttribute("aria-label", "Abrir navegación");
    menu?.classList.remove("is-open");
  };
  menuButton?.addEventListener("click", () => {
    const open = menuButton.getAttribute("aria-expanded") !== "true";
    menuButton.setAttribute("aria-expanded", String(open));
    menuButton.setAttribute("aria-label", open ? "Cerrar navegación" : "Abrir navegación");
    menu?.classList.toggle("is-open", open);
  });
  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });

  const tour = document.querySelector<HTMLElement>("[data-tour]");
  if (tour) {
    const chapters = Array.from(tour.querySelectorAll<HTMLElement>("[data-chapter]"));
    const screens = tour.querySelectorAll<HTMLElement>(".tour-phone .screen");
    const dots = Array.from(tour.querySelectorAll<HTMLButtonElement>("[data-goto]"));
    let activeStep = -1;
    const showStep = (index: number) => {
      if (index === activeStep) return;
      activeStep = index;
      screens.forEach((screen, i) => screen.classList.toggle("on", i === index));
      chapters.forEach((chapter, i) => chapter.classList.toggle("is-active", i === index));
      dots.forEach((dot, i) => i === index ? dot.setAttribute("aria-current", "step") : dot.removeAttribute("aria-current"));
    };
    showStep(0);
    chapters.forEach((chapter, index) => {
      ScrollTrigger.create({
        trigger: chapter,
        start: "top 58%",
        end: "bottom 42%",
        onEnter: () => showStep(index),
        onEnterBack: () => showStep(index),
      });
    });
    dots.forEach((dot, index) => dot.addEventListener("click", () => {
      const chapter = chapters[index];
      if (!chapter) return;
      const top = chapter.getBoundingClientRect().top + window.scrollY - (window.innerHeight - chapter.offsetHeight) / 2;
      window.scrollTo({ top, behavior: reducedMotion ? "auto" : "smooth" });
    }));
  }

  const calcForm = document.querySelector<HTMLFormElement>("[data-calc]");
  if (calcForm) {
    const weightInput = calcForm.querySelector<HTMLInputElement>('input[name="weight"]')!;
    const weightValue = calcForm.querySelector<HTMLElement>("[data-weight-value]")!;
    const ring = document.querySelector<HTMLElement>("[data-result-ring]")!;
    const setResult = (key: string, value: string) => {
      document.querySelectorAll(`[data-result="${key}"]`).forEach((element) => { element.textContent = value; });
    };
    const calculate = () => {
      const data = new FormData(calcForm);
      const name = String(data.get("dogName") || "").trim() || "tu perro";
      const weight = Number(data.get("weight"));
      const activity = Number(data.get("activity"));
      const dailyCalories = 70 * Math.pow(weight, 0.75) * 1.6 * activity;
      const grams = Math.max(20, Math.round(dailyCalories / 3.6 / 10) * 10);
      const days = Math.max(1, Math.floor(12500 / grams));
      setResult("name", name);
      setResult("grams", String(grams));
      setResult("days", String(days));
      ring.style.setProperty("--progress", String(Math.min(1, days / 60)));
    };
    calcForm.querySelectorAll<HTMLButtonElement>("[data-weight]").forEach((button) => {
      button.addEventListener("click", () => {
        const nextWeight = Math.min(80, Math.max(2, Number(weightInput.value) + Number(button.dataset.weight)));
        weightInput.value = String(nextWeight);
        weightValue.textContent = String(nextWeight);
        calculate();
      });
    });
    calcForm.addEventListener("input", calculate);
    calcForm.addEventListener("submit", (event) => event.preventDefault());
    calculate();
  }

  const waitlistForm = document.querySelector<HTMLFormElement>("[data-waitlist-form]");
  const formStatus = document.querySelector<HTMLElement>("[data-form-status]");
  waitlistForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!waitlistForm.reportValidity()) return;
    if (formStatus) formStatus.textContent = "Gracias por tu interés. Esta demostración no guarda ni envía tu correo.";
  });

  if (!reducedMotion) {
    gsap.from("[data-hero-item]", { y: 30, autoAlpha: 0, duration: 0.85, stagger: 0.1, ease: "power3.out" });
    gsap.from("[data-hero-product]", { y: 50, rotate: 2, autoAlpha: 0, duration: 1.1, delay: 0.2, ease: "power3.out" });
    gsap.from(".floating-card", { y: 20, autoAlpha: 0, duration: 0.65, delay: 0.8, stagger: 0.15, ease: "power2.out" });
    gsap.to(".hero-phone", { y: -12, duration: 3.2, repeat: -1, yoyo: true, ease: "sine.inOut" });
    gsap.to(".orbit-one", { rotate: 35, duration: 28, repeat: -1, ease: "none" });
    document.querySelectorAll<HTMLElement>("main > section:not(.hero), .neighborhood").forEach((section) => {
      const items = section.querySelectorAll("[data-reveal]");
      if (!items.length) return;
      gsap.from(items, {
        y: 28,
        autoAlpha: 0,
        duration: 0.75,
        stagger: 0.09,
        ease: "power3.out",
        scrollTrigger: { trigger: section, start: "top 80%", once: true },
      });
    });
  }
  window.addEventListener("load", () => ScrollTrigger.refresh());
</script>

<style>
  .lia-home {
    --deep: #0b3d4a;
    --deepest: #072e39;
    --teal: #0d9488;
    --mint: #78d2c8;
    --orange: #f47c2c;
    --orange-dark: #d95e13;
    --paper: #f4f7f6;
    --white: #ffffff;
    --ink: #123c48;
    --muted: #5d747a;
    --line: #dce6e7;
    --display: "Bricolage Grotesque", "Inter", sans-serif;
    --body: "Inter", sans-serif;
    min-height: 100vh;
    overflow: clip;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--body);
  }
  .lia-home *, .lia-home *::before, .lia-home *::after { box-sizing: border-box; }
  .lia-home h1, .lia-home h2, .lia-home h3, .lia-home p, .lia-home figure, .lia-home ul, .lia-home ol { margin: 0; }
  .lia-home ul, .lia-home ol { padding: 0; list-style: none; }
  .lia-home img { display: block; max-width: 100%; }
  .lia-home a { color: inherit; text-decoration: none; }
  .lia-home button, .lia-home input { font: inherit; }
  .lia-home button { color: inherit; }
  .lia-home :focus-visible { outline: 3px solid var(--orange); outline-offset: 4px; }
  .lia-home ::selection { background: var(--mint); color: var(--deepest); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .skip-link { position: fixed; top: -80px; left: 20px; z-index: 100; padding: 12px 18px; border-radius: 8px; background: var(--orange); color: var(--deepest); font-weight: 800; }
  .skip-link:focus { top: 16px; }
  .section { padding-block: clamp(90px, 10vw, 150px); }
  .section-wrap { width: min(1240px, calc(100% - 80px)); margin-inline: auto; }
  .eyebrow { display: flex; align-items: center; gap: 12px; color: var(--teal); font-size: 11px; font-weight: 800; letter-spacing: .15em; line-height: 1.4; text-transform: uppercase; }
  .eyebrow > span { color: var(--orange); }
  .eyebrow-light { color: var(--mint); }
  .button { display: inline-flex; min-height: 54px; align-items: center; justify-content: center; gap: 22px; border: 0; border-radius: 999px; padding: 0 26px; cursor: pointer; font-size: 13px; font-weight: 800; line-height: 1.2; transition: transform .25s cubic-bezier(.2,.7,.2,1), background .2s ease, box-shadow .25s ease; }
  .button span { font-size: 18px; font-weight: 500; transition: transform .25s ease; }
  .button:hover { transform: translateY(-3px); }
  .button:hover span { transform: translate(2px, -2px); }
  .button:active { transform: translateY(0) scale(.97); }
  .button-primary { background: var(--orange); color: #082f3a; box-shadow: 0 12px 30px rgb(244 124 44 / 18%); }
  .button-primary:hover { background: #ff9149; box-shadow: 0 16px 35px rgb(244 124 44 / 26%); }
  .button-ghost { border: 1px solid rgb(255 255 255 / 25%); background: rgb(255 255 255 / 4%); color: white; }
  .button-ghost:hover { background: rgb(255 255 255 / 10%); }
  .button-small { min-height: 44px; gap: 14px; padding-inline: 20px; font-size: 12px; }
  .button-full { width: 100%; }
  .text-link { display: inline-flex; align-items: center; gap: 18px; border-bottom: 1px solid #aac0c4; padding-bottom: 8px; color: var(--deep); font-size: 13px; font-weight: 800; transition: gap .2s ease, color .2s ease; }
  .text-link:hover { gap: 24px; color: var(--teal); }
  .text-link-light { border-color: rgb(255 255 255 / 35%); color: white; }
  .text-link-light:hover { color: var(--mint); }

  /* Navegación */
  .site-header { position: absolute; z-index: 30; top: 0; right: 0; left: 0; color: white; }
  .nav-wrap { display: flex; width: min(1360px, calc(100% - 64px)); height: 92px; align-items: center; gap: 36px; margin-inline: auto; border-bottom: 1px solid rgb(255 255 255 / 12%); }
  .brand { display: inline-flex; align-items: center; gap: 9px; font-family: var(--display); font-size: 28px; font-weight: 800; letter-spacing: -.06em; }
  .brand img { width: 43px; height: 43px; object-fit: contain; }
  .main-nav { display: flex; align-items: center; gap: clamp(22px, 2.7vw, 42px); margin-left: auto; font-size: 12px; font-weight: 600; }
  .main-nav a { position: relative; padding-block: 12px; color: #c9dadd; transition: color .2s ease; }
  .main-nav a::after { position: absolute; right: 0; bottom: 5px; left: 0; height: 1px; background: var(--orange); content: ""; transform: scaleX(0); transform-origin: right; transition: transform .25s ease; }
  .main-nav a:hover { color: white; }
  .main-nav a:hover::after { transform: scaleX(1); transform-origin: left; }
  .nav-cta { margin-left: 10px; background: var(--orange); color: var(--deepest); }
  .menu-toggle { display: none; }

  /* Hero */
  .hero { position: relative; min-height: 890px; overflow: hidden; padding-top: 92px; background: var(--deepest); color: white; isolation: isolate; }
  .hero::before { position: absolute; z-index: -3; inset: 0; background: radial-gradient(circle at 76% 47%, #155563 0, transparent 43%); content: ""; }
  .hero-grid { display: grid; width: min(1240px, calc(100% - 80px)); min-height: 705px; grid-template-columns: minmax(0, 1.04fr) minmax(420px, .96fr); align-items: center; gap: 30px; margin-inline: auto; padding-block: 58px 42px; }
  .hero-copy { position: relative; z-index: 4; max-width: 680px; }
  .hero-eyebrow { color: var(--mint); }
  .hero-eyebrow > span { width: 8px; height: 8px; border-radius: 50%; background: var(--orange); box-shadow: 0 0 0 6px rgb(244 124 44 / 12%); }
  .hero h1 { max-width: 690px; margin-top: 25px; font-family: var(--display); font-size: clamp(62px, 6.25vw, 94px); font-weight: 650; letter-spacing: -.07em; line-height: .94; text-wrap: balance; }
  .hero h1 em { display: inline; color: var(--orange); font-style: normal; }
  .hero-intro { max-width: 540px; margin-top: 28px !important; color: #bfd1d5; font-size: 16px; line-height: 1.75; text-wrap: pretty; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }
  .hero-assurances { display: flex; flex-wrap: wrap; gap: 12px 24px; margin-top: 29px !important; color: #9eb9bf; font-size: 10px; }
  .hero-assurances li { display: flex; align-items: center; gap: 7px; }
  .hero-assurances li > span { color: var(--mint); font-weight: 800; }
  .hero-product { position: relative; z-index: 2; display: grid; min-height: 610px; place-items: center; }
  .product-halo { position: absolute; z-index: -1; width: 540px; height: 540px; border: 1px solid rgb(120 210 200 / 17%); border-radius: 50%; }
  .product-halo::before, .product-halo::after { position: absolute; border: 1px solid rgb(120 210 200 / 10%); border-radius: inherit; content: ""; }
  .product-halo::before { inset: 48px; }
  .product-halo::after { inset: 100px; background: rgb(120 210 200 / 4%); }
  .hero-phone { position: relative; z-index: 2; transform: rotate(4deg) scale(1.06); filter: drop-shadow(0 40px 45px rgb(0 0 0 / 30%)); }
  .hero-phone .phone { box-shadow: inset 0 0 0 1.5px #2c373a, inset 0 0 0 4px #10181a, inset 0 0 0 5px #1e282b, 0 32px 60px rgb(0 0 0 / 35%); }
  .floating-card { position: absolute; z-index: 3; display: flex; align-items: center; gap: 11px; border: 1px solid rgb(255 255 255 / 65%); border-radius: 16px; padding: 13px 15px; background: rgb(255 255 255 / 93%); color: var(--deep); box-shadow: 0 20px 40px rgb(0 0 0 / 18%); backdrop-filter: blur(14px); }
  .floating-card small, .floating-card strong { display: block; }
  .floating-card small { margin-bottom: 3px; color: #668087; font-size: 8px; }
  .floating-card strong { font-size: 11px; }
  .floating-icon { display: grid; width: 34px; height: 34px; place-items: center; border-radius: 10px; background: #e7f5f2; color: var(--teal); }
  .floating-icon svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .delivery-card { bottom: 96px; left: -12px; }
  .delivery-card > i { width: 7px; height: 7px; margin-left: 8px; border-radius: 50%; background: var(--teal); box-shadow: 0 0 0 5px rgb(13 148 136 / 10%); }
  .covered-card { top: 90px; right: -5px; padding: 12px 16px; }
  .covered-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--orange); }
  .demo-caption { position: absolute; right: 0; bottom: 20px; left: 0; color: #8ba9af; font-size: 8px; letter-spacing: .12em; text-align: center; text-transform: uppercase; }
  .hero-word { position: absolute; z-index: -1; right: -2vw; bottom: -7vw; color: rgb(255 255 255 / 2.5%); font-family: var(--display); font-size: 34vw; font-weight: 800; letter-spacing: -.12em; line-height: .75; }
  .hero-orbit { position: absolute; z-index: -1; border: 1px solid rgb(120 210 200 / 8%); border-radius: 50%; pointer-events: none; }
  .orbit-one { top: -400px; left: -260px; width: 820px; height: 820px; border-top-color: rgb(120 210 200 / 28%); }
  .orbit-two { right: -320px; bottom: -440px; width: 850px; height: 850px; }
  .hero-bottom { display: flex; position: absolute; right: 0; bottom: 0; left: 0; width: min(1360px, calc(100% - 64px)); height: 82px; align-items: center; justify-content: space-between; margin-inline: auto; border-top: 1px solid rgb(255 255 255 / 12%); color: #9eb9bf; font-size: 10px; letter-spacing: .08em; text-transform: uppercase; }
  .hero-bottom a { display: flex; align-items: center; gap: 14px; color: white; }
  .hero-bottom i { display: block; width: 30px; height: 30px; border: 1px solid rgb(255 255 255 / 25%); border-radius: 50%; }
  .hero-bottom i::after { display: block; margin-top: 7px; content: "↓"; font-style: normal; text-align: center; }


  /* Historia */
  .story { background: var(--paper); }
  .story-grid { display: grid; grid-template-columns: .86fr 1.14fr; align-items: center; gap: clamp(60px, 9vw, 140px); }
  .story h2, .section-heading h2, .calc-copy h2, .benefits-heading h2, .neighborhood h2, .closing h2 { margin-top: 24px; font-family: var(--display); font-size: clamp(48px, 5.4vw, 78px); font-weight: 650; letter-spacing: -.065em; line-height: .98; text-wrap: balance; }
  .story h2 em, .section-heading h2 em, .benefits-heading h2 em { color: var(--teal); font-style: normal; }
  .section-intro { max-width: 450px; margin-top: 28px !important; color: var(--muted); font-size: 16px; line-height: 1.8; }
  .story-copy .text-link { margin-top: 35px; }
  .story-visual { position: relative; padding: 0 0 62px 42px; }
  .story-photo { position: relative; overflow: hidden; aspect-ratio: 1.15; border-radius: 180px 24px 24px 24px; background: #d8e4e0; }
  .story-photo img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s cubic-bezier(.2,.7,.2,1); }
  .story-photo:hover img { transform: scale(1.035); }
  .story-quote { position: absolute; right: -24px; bottom: 18px; display: flex; max-width: 390px; align-items: flex-start; gap: 14px; border-radius: 18px; padding: 25px 28px; background: var(--deep); color: white; box-shadow: 0 22px 45px rgb(11 61 74 / 17%); }
  .quote-mark { color: var(--orange); font-family: Georgia, serif; font-size: 52px; line-height: .8; }
  .story-quote p { font-family: var(--display); font-size: 21px; font-weight: 600; letter-spacing: -.04em; line-height: 1.3; }
  .photo-credit { position: absolute; bottom: 0; left: 42px; color: #71878b; font-size: 8px; }
  .photo-credit a { text-decoration: underline; text-underline-offset: 2px; }

  /* Recorrido */
  .how { padding-top: 40px; background: #fff; }
  .section-heading { display: grid; grid-template-columns: 1fr 1fr; align-items: end; gap: 30px; padding-bottom: 60px; border-bottom: 1px solid var(--line); }
  .section-heading .eyebrow { grid-column: 1 / -1; }
  .section-heading h2 { margin-top: 0; }
  .section-heading > p:last-child { max-width: 420px; justify-self: end; padding-bottom: 5px; color: var(--muted); font-size: 15px; line-height: 1.8; }
  .how-layout { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(60px, 10vw, 150px); }
  .tour-stage { position: sticky; top: 0; display: flex; height: 100vh; flex-direction: column; align-items: center; justify-content: center; gap: 24px; }
  .tour-phone { position: relative; }
  .tour-phone::before { position: absolute; z-index: -1; top: 50%; left: 50%; width: 440px; height: 440px; border: 1px solid var(--line); border-radius: 50%; background: #f2f8f6; content: ""; transform: translate(-50%, -50%); }
  .tour-phone::after { position: absolute; z-index: -1; top: 50%; left: 50%; width: 350px; height: 350px; border: 1px dashed #bfd7d3; border-radius: 50%; content: ""; transform: translate(-50%, -50%); }
  .tour-pagination { display: flex; gap: 8px; }
  .tour-pagination button { display: flex; min-width: 44px; min-height: 44px; align-items: center; justify-content: center; gap: 7px; border: 0; border-radius: 999px; padding: 0 12px; background: transparent; color: #91a4a8; cursor: pointer; font-size: 9px; font-weight: 800; transition: background .2s, color .2s; }
  .tour-pagination button span { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .tour-pagination button[aria-current="step"] { background: var(--deep); color: white; }
  .chapters { padding-block: 16vh; }
  .chapter { display: flex; min-height: 68vh; flex-direction: column; justify-content: center; opacity: .28; transition: opacity .4s ease; }
  .chapter.is-active { opacity: 1; }
  .chapter-number { color: #c1d1d4; font-family: var(--display); font-size: 76px; font-weight: 600; letter-spacing: -.08em; line-height: 1; }
  .chapter-kicker { margin-top: 22px !important; color: var(--teal); font-size: 10px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .chapter h3 { max-width: 470px; margin-top: 10px; font-family: var(--display); font-size: clamp(38px, 4vw, 56px); font-weight: 650; letter-spacing: -.06em; line-height: 1.03; }
  .chapter > p:not(.chapter-kicker) { max-width: 430px; margin-top: 22px !important; color: var(--muted); font-size: 15px; line-height: 1.8; }
  .chapter-note { display: flex; align-items: center; gap: 10px; margin-top: 24px; color: var(--ink); font-size: 11px; font-weight: 700; }
  .chapter-note i { width: 7px; height: 7px; border-radius: 50%; background: var(--orange); }

  /* Calculadora */
  .calculator { position: relative; overflow: hidden; background: var(--deep); color: white; isolation: isolate; }
  .calc-grid { display: grid; grid-template-columns: .85fr 1.15fr; align-items: center; gap: clamp(60px, 9vw, 130px); }
  .calc-copy h2 em, .neighborhood h2 em { color: var(--mint); font-style: normal; }
  .calc-copy > p:not(.eyebrow):not(.calc-disclaimer) { max-width: 420px; margin-top: 27px !important; color: #bdd2d6; font-size: 15px; line-height: 1.8; }
  .calc-disclaimer { max-width: 390px; margin-top: 28px !important; border-left: 2px solid var(--orange); padding-left: 15px; color: #8fb0b6; font-size: 10px; line-height: 1.7; }
  .calc-orbit { position: absolute; z-index: -1; top: -220px; left: -230px; width: 620px; height: 620px; border: 1px solid rgb(120 210 200 / 10%); border-radius: 50%; box-shadow: 0 0 0 70px rgb(120 210 200 / 2%), 0 0 0 140px rgb(120 210 200 / 2%); }
  .calc-panel { border-radius: 28px; padding: clamp(25px, 3.4vw, 44px); background: var(--paper); color: var(--ink); box-shadow: 0 30px 70px rgb(0 0 0 / 16%); }
  .calc-form { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 20px; }
  .field { display: grid; min-width: 0; gap: 9px; border: 0; padding: 0; }
  .field > span, .field legend { color: var(--muted); font-size: 11px; font-weight: 700; }
  .field legend { margin-bottom: 9px; }
  .field input:not([type="radio"]):not([type="hidden"]) { width: 100%; min-height: 54px; border: 1px solid var(--line); border-radius: 12px; padding: 0 16px; background: white; color: var(--ink); font-size: 15px; }
  .weight-stepper { display: grid; min-height: 54px; grid-template-columns: 52px 1fr 52px; align-items: center; border: 1px solid var(--line); border-radius: 12px; background: white; }
  .weight-stepper button { height: 52px; border: 0; border-radius: 10px; background: transparent; color: var(--teal); cursor: pointer; font-size: 22px; transition: background .2s; }
  .weight-stepper button:hover { background: #e5f3ef; }
  .weight-stepper output { display: flex; align-items: baseline; justify-content: center; gap: 5px; }
  .weight-stepper strong { font-family: var(--display); font-size: 22px; }
  .weight-stepper small { color: var(--muted); font-size: 11px; }
  .activity-field { grid-column: 1 / -1; }
  .segment-control { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; border-radius: 13px; padding: 4px; background: #e5edec; }
  .segment-control input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .segment-control span { display: grid; min-height: 43px; place-items: center; border-radius: 10px; cursor: pointer; font-size: 11px; font-weight: 700; transition: background .2s, color .2s; }
  .segment-control input:checked + span { background: var(--deep); color: white; }
  .segment-control input:focus-visible + span { outline: 3px solid var(--orange); outline-offset: 2px; }
  .calc-result { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 25px; margin-block: 28px 20px; border-radius: 20px; padding: 24px; background: var(--deep); color: white; }
  .result-ring { position: relative; display: grid; width: 106px; height: 106px; place-items: center; border-radius: 50%; background: conic-gradient(var(--mint) calc(var(--progress) * 360deg), #285763 0); }
  .result-ring::before { position: absolute; width: 88px; height: 88px; border-radius: 50%; background: var(--deep); content: ""; }
  .result-ring > span { position: relative; display: grid; text-align: center; }
  .result-ring strong { font-family: var(--display); font-size: 36px; line-height: 1; }
  .result-ring small { margin-top: 4px; color: #b6cfd3; font-size: 8px; }
  .result-copy p { max-width: 260px; font-family: var(--display); font-size: 23px; font-weight: 600; letter-spacing: -.035em; line-height: 1.2; }
  .result-copy p strong { color: var(--mint); }
  .result-copy > span { display: block; margin-top: 9px; color: #b6cfd3; font-size: 11px; }

  /* Beneficios */
  .benefits { background: var(--paper); }
  .benefits-heading { display: flex; align-items: end; justify-content: space-between; gap: 30px; }
  .benefits-heading h2 { max-width: 780px; }
  .benefit-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 62px; }
  .benefit-card { position: relative; min-height: 335px; overflow: hidden; border: 1px solid var(--line); border-radius: 22px; padding: 28px; background: white; transition: transform .3s cubic-bezier(.2,.7,.2,1), box-shadow .3s ease; }
  .benefit-card:hover { transform: translateY(-7px); box-shadow: 0 24px 45px rgb(11 61 74 / 8%); }
  .benefit-top { display: flex; align-items: center; justify-content: space-between; }
  .benefit-icon { display: grid; width: 48px; height: 48px; place-items: center; border-radius: 14px; background: #e8f4f1; color: var(--teal); }
  .benefit-icon svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .benefit-number { color: #a0b5b9; font-size: 10px; font-weight: 800; }
  .benefit-card h3 { max-width: 290px; margin-top: 54px; font-family: var(--display); font-size: 26px; font-weight: 650; letter-spacing: -.045em; line-height: 1.1; }
  .benefit-card p { margin-top: 15px !important; color: var(--muted); font-size: 13px; line-height: 1.75; }
  .benefit-line { position: absolute; right: 28px; bottom: 0; left: 28px; height: 3px; border-radius: 3px 3px 0 0; background: var(--orange); transform: scaleX(0); transform-origin: left; transition: transform .35s ease; }
  .benefit-card:hover .benefit-line { transform: scaleX(1); }

  /* Barrio */
  .neighborhood { display: grid; grid-template-columns: 1fr 1fr; background: var(--deepest); color: white; }
  .neighborhood-photo { position: relative; min-height: 610px; overflow: hidden; }
  .neighborhood-photo::after { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgb(7 46 57 / 60%)); content: ""; }
  .neighborhood-photo img { width: 100%; height: 100%; object-fit: cover; }
  .neighborhood-photo p { position: absolute; z-index: 1; bottom: 18px; left: 24px; color: #d7e1e2; font-size: 8px; }
  .neighborhood-photo a { text-decoration: underline; text-underline-offset: 2px; }
  .neighborhood-copy { display: flex; max-width: 650px; flex-direction: column; align-items: flex-start; justify-content: center; padding: clamp(55px, 7vw, 100px); }
  .neighborhood h2 { font-size: clamp(44px, 4.7vw, 68px); }
  .neighborhood-copy > p:not(.eyebrow) { max-width: 450px; margin-top: 27px !important; color: #b8cfd3; font-size: 15px; line-height: 1.8; }
  .neighborhood-copy .text-link { margin-top: 34px; }

  /* Quiénes somos */
  .about { background: white; }
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; align-items: start; gap: clamp(55px, 9vw, 130px); }
  .about-heading h2 { margin-top: 24px; font-family: var(--display); font-size: clamp(45px, 4.8vw, 68px); font-weight: 650; letter-spacing: -.06em; line-height: 1; text-wrap: balance; }
  .about-heading h2 em { color: var(--teal); font-style: normal; }
  .about-copy { padding-top: 36px; }
  .about-copy > p { color: var(--muted); font-size: 16px; line-height: 1.85; text-wrap: pretty; }
  .about-copy > p + p { margin-top: 20px !important; }
  .about-copy strong { color: var(--ink); font-weight: 750; }
  .about-values { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 30px; }
  .about-values span { border: 1px solid var(--line); border-radius: 999px; padding: 9px 13px; color: var(--deep); font-size: 10px; font-weight: 700; }

  /* Cierre */
  .closing { position: relative; overflow: hidden; background: var(--mint); text-align: center; isolation: isolate; }
  .closing-inner { position: relative; z-index: 1; width: min(900px, calc(100% - 48px)); margin-inline: auto; }
  .closing .eyebrow { justify-content: center; color: var(--deep); }
  .closing h2 { font-size: clamp(50px, 6.5vw, 86px); }
  .closing h2 em { color: var(--deep); font-style: normal; }
  .closing-inner > p:not(.eyebrow):not(.form-status) { max-width: 540px; margin: 25px auto 0 !important; color: #255760; font-size: 15px; line-height: 1.7; }
  .waitlist-form { display: flex; max-width: 600px; gap: 10px; margin: 36px auto 0; border: 1px solid rgb(11 61 74 / 17%); border-radius: 999px; padding: 6px; background: white; box-shadow: 0 18px 45px rgb(11 61 74 / 10%); }
  .waitlist-form input { min-width: 0; min-height: 52px; flex: 1; border: 0; border-radius: 999px; padding: 0 20px; background: transparent; color: var(--ink); font-size: 14px; outline: none; }
  .waitlist-form input:focus { box-shadow: inset 0 0 0 2px var(--teal); }
  .form-status { margin-top: 14px !important; color: #315f66; font-size: 9px; }
  .closing-orbit { position: absolute; z-index: -1; top: 50%; left: 50%; width: 880px; height: 880px; border: 1px solid rgb(11 61 74 / 9%); border-radius: 50%; box-shadow: 0 0 0 100px rgb(11 61 74 / 2%), 0 0 0 200px rgb(11 61 74 / 2%); transform: translate(-50%, -50%); }

  /* Pie */
  .site-footer { padding: 50px max(40px, calc((100% - 1240px) / 2)); background: var(--deepest); color: white; }
  .footer-top { display: grid; grid-template-columns: 1fr 1fr 1fr; align-items: center; gap: 30px; padding-bottom: 45px; }
  .footer-top > p { color: #b3c9ce; font-family: var(--display); font-size: 20px; font-weight: 550; letter-spacing: -.035em; line-height: 1.4; }
